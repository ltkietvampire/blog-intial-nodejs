<div class="employee-statistics-view">
<div class="container py-4 stats-wrap">
  <div class="d-flex flex-wrap gap-3 justify-content-between align-items-start mb-3">
    <div>
      <h3 class="stats-title">Employee Statistics</h3>
      <div class="stats-subtitle">Updated at: {{generatedAt}}</div>
      <div class="stats-subtitle">Filter: {{periodLabel}}</div>
    </div>

    <div class="d-flex gap-2">
      <form method="GET" action="/employee/statistics" class="d-flex gap-2">
        <select name="period" class="form-select form-select-sm" style="min-width: 140px">
          {{#each periodOptions}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        <button type="submit" class="btn btn-outline-secondary btn-sm">Apply</button>
      </form>
      <a href="/employee/statistics/export?period={{selectedPeriod}}" class="btn btn-outline-success btn-sm">
        Export CSV
      </a>
      <a href="/employee/statistics/export-salary?period={{selectedPeriod}}" class="btn btn-outline-success btn-sm">
        Xuất Bảng Lương
      </a>
      <a href="/employee" class="btn btn-outline-secondary btn-sm">Employee List</a>
      <a href="/tasks" class="btn btn-primary btn-sm">Task Management</a>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-2 col-6">
      <div class="card stats-card p-3">
        <div class="metric-label">Employees</div>
        <div class="metric-value">{{report.length}}</div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="card stats-card p-3">
        <div class="metric-label">Total Work Hours</div>
        <div class="metric-value">{{totals.workHours}}h</div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="card stats-card p-3">
        <div class="metric-label">Total Paid Salary</div>
        <div class="metric-value format-currency" data-value="{{totals.totalPaidSalary}}">{{totals.totalPaidSalary}}</div>
      </div>
    </div>
    <div class="col-md-2 col-6">
      <div class="card stats-card p-3">
        <div class="metric-label">Total Late</div>
        <div class="metric-value">{{totals.lateCount}}</div>
      </div>
    </div>
    <div class="col-md-2 col-6">
      <div class="card stats-card p-3">
        <div class="metric-label">Skipped Tasks</div>
        <div class="metric-value">{{totals.skippedCount}}</div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-lg-8">
      <div class="chart-card p-3">
        <div class="chart-title">Work Hours by Employee</div>
        <div class="chart-wrap">
          <canvas id="workHoursChart"></canvas>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="chart-card p-3">
        <div class="chart-title">Assignment Status Ratio</div>
        <div class="chart-wrap">
          <canvas id="assignmentStatusChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-12">
      <div class="chart-card p-3">
        <div class="chart-title">Paid Salary by Employee</div>
        <div class="chart-wrap" style="height: 300px;">
          <canvas id="salaryChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <div class="card stats-card p-3">
    <div class="table-responsive">
      <table class="table table-hover stats-table align-middle mb-0">
        <thead>
          <tr>
            <th>Employee</th>
            <th>Position</th>
            <th>Assigned Tasks</th>
            <th>Total Work Hours</th>
            <th>Paid Salary</th>
            <th>Late Time</th>
            <th>Late Count</th>
            <th>Skipped Tasks</th>
            <th>Max Work Hours/Day</th>
          </tr>
        </thead>

        <tbody>
          {{#if report.length}}
            {{#each report}}
              <tr>
                <td>
                  <div class="employee-name">{{this.name}}</div>
                  <div class="employee-role">{{this.email}}</div>
                </td>
                <td>{{this.position}}</td>
                <td><span class="badge-soft">{{this.assignedTasks}}</span></td>
                <td>{{this.workHours}}h</td>
                <td class="format-currency" data-value="{{this.totalPaidSalary}}">{{this.totalPaidSalary}}</td>
                <td>{{this.lateText}}</td>
                <td>{{this.lateCount}}</td>
                <td>{{this.skippedCount}}</td>
                <td>{{this.maxtime}}h</td>
              </tr>
            {{/each}}
          {{else}}
            <tr>
              <td colspan="9" class="text-center py-4 text-muted">
                No employee statistics available.
              </td>
            </tr>
          {{/if}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Chart === 'undefined') return;

    const report = {{#if report}}{{{json report}}}{{else}}[]{{/if}};
    const totals = {{#if totals}}{{{json totals}}}{{else}}{"assignedTasks":0,"lateCount":0,"skippedCount":0}{{/if}};

    document.querySelectorAll('.format-currency').forEach(el => {
      const val = Number(el.getAttribute('data-value')) || 0;
      el.textContent = val.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' });
    });

    const labels = report.map((item) => item.name || 'N/A');
    const hours = report.map((item) => Number(item.workHours) || 0);
    const salaries = report.map((item) => Number(item.totalPaidSalary) || 0);

    const workHoursCtx = document.getElementById('workHoursChart');
    if (workHoursCtx) {
      new Chart(workHoursCtx, {
        type: 'bar',
        data: {
          labels,
          datasets: [{
            label: 'Work hours',
            data: hours,
            borderRadius: 8,
            backgroundColor: '#3b82f6',
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                callback: function (value) { return `${value}h`; },
              },
            },
          },
        },
      });
    }

    const assignedTasks = Number(totals.assignedTasks) || 0;
    const lateCount = Number(totals.lateCount) || 0;
    const skippedCount = Number(totals.skippedCount) || 0;
    const onTimeCount = Math.max(assignedTasks - lateCount - skippedCount, 0);

    const statusCtx = document.getElementById('assignmentStatusChart');
    if (statusCtx) {
      new Chart(statusCtx, {
        type: 'doughnut',
        data: {
          labels: ['On time', 'Late', 'Skipped'],
          datasets: [{
            data: [onTimeCount, lateCount, skippedCount],
            backgroundColor: ['#22c55e', '#f59e0b', '#ef4444'],
            borderWidth: 0,
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' },
          },
        },
      });
    }

    const salaryCtx = document.getElementById('salaryChart');
    if (salaryCtx) {
      new Chart(salaryCtx, {
        type: 'bar',
        data: {
          labels,
          datasets: [{
            label: 'Paid Salary',
            data: salaries,
            borderRadius: 8,
            backgroundColor: '#10b981',
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
                callbacks: {
                    label: function(context) {
                        let label = context.dataset.label || '';
                        if (label) {
                            label += ': ';
                        }
                        if (context.parsed.y !== null) {
                            label += new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.y);
                        }
                        return label;
                    }
                }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                callback: function (value) { 
                    return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(value); 
                },
              },
            },
          },
        },
      });
    }
  });
</script>
</div>
