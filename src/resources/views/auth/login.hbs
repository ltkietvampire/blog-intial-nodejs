<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Sign In | Task & Schedule</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap + Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    :root {
      --bg: #f8fafc;
      --card: #ffffff;
      --text: #111827;
      --sub: #6b7280;
      --primary: #4f46e5;
    }

    body.dark {
      --bg: #0f172a;
      --card: #020617;
      --text: #e5e7eb;
      --sub: #94a3b8;
      --primary: #6366f1;
    }

    body {
      min-height: 100vh;
      background: var(--bg);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: system-ui;
      transition: .3s;
    }

    .login-wrapper {
      width: 100%;
      max-width: 920px;
      background: var(--card);
      border-radius: 20px;
      box-shadow: 0 30px 60px rgba(0,0,0,.15);
      overflow: hidden;
      display: grid;
      grid-template-columns: 1fr 1fr;
      animation: fadeUp .4s ease;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* LEFT */
    .login-visual {
      background: linear-gradient(135deg, #6366f1, #4f46e5);
      color: white;
      padding: 40px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .login-visual h2 {
      font-weight: 700;
    }

    /* RIGHT */
    .login-form {
      padding: 40px;
      color: var(--text);
    }

    .avatar {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      margin: 0 auto 16px;
      background: url("https://i.pravatar.cc/150") center/cover;
      transition: .3s;
    }

    .form-control {
      border-radius: 12px;
      padding-left: 44px;
      height: 46px;
      background: transparent;
      color: var(--text);
    }

    .input-icon {
      position: absolute;
      top: 50%;
      left: 14px;
      transform: translateY(-50%);
      color: #9ca3af;
    }

    .btn-login {
      background: var(--primary);
      border: none;
      border-radius: 12px;
      padding: 12px;
      font-weight: 600;
    }

    .shake {
      animation: shake .3s;
    }

    @keyframes shake {
      0% { transform: translateX(0); }
      25% { transform: translateX(-6px); }
      50% { transform: translateX(6px); }
      75% { transform: translateX(-4px); }
      100% { transform: translateX(0); }
    }

    .dark-toggle {
      position: absolute;
      top: 20px;
      right: 20px;
      cursor: pointer;
    }

    @media (max-width: 768px) {
      .login-wrapper {
        grid-template-columns: 1fr;
      }
      .login-visual {
        display: none;
      }
    }
  </style>
</head>

<body class="{{#if error}}dark{{/if}}">

<div class="dark-toggle" onclick="toggleDark()">
  🌙
</div>

<div class="login-wrapper {{#if error}}shake{{/if}}">

  <!-- LEFT -->
  <div class="login-visual">
    <h2>Task & Schedule</h2>
    <p>Manage tasks, schedules, and teams more effectively every day.</p>
  </div>

  <!-- RIGHT -->
  <div class="login-form text-center">
    <div class="avatar" id="avatar"></div>

    <h5 class="fw-semibold mb-1">Sign In</h5>
    <p class="text-muted mb-4">Welcome back 👋</p>

    <form action="/login/checked" method="POST" onsubmit="loading(this)">

      <div class="mb-3 position-relative">
        <i class="bi bi-envelope input-icon"></i>
        <input
          type="email"
          name="email"
          class="form-control"
          placeholder="Email"
          value="{{email}}"
          oninput="updateAvatar(this.value)"
          required
        >
      </div>

      <div class="mb-3 position-relative">
        <i class="bi bi-lock input-icon"></i>
        <input
          type="password"
          name="password"
          class="form-control"
          placeholder="Password"
          required
        >
      </div>

      {{#if error}}
        <div class="alert alert-danger py-2">
          {{error}}
        </div>
      {{/if}}
      {{#if flash.error.length}}
        {{#each flash.error}}
          <div class="alert alert-warning py-2">
            {{this}}
          </div>
        {{/each}}
      {{/if}}

      <button type="submit" class="btn btn-login w-100" id="btn">
        <span id="btnText">Sign In</span>
        <span id="spinner" class="spinner-border spinner-border-sm d-none"></span>
      </button>
    </form>
  </div>

</div>

<script>
  function loading(form) {
    document.getElementById("btnText").style.display = "none";
    document.getElementById("spinner").classList.remove("d-none");
  }

  function updateAvatar(email) {
    if (!email) return;
    document.getElementById("avatar").style.backgroundImage =
      `url(https://api.dicebear.com/7.x/identicon/svg?seed=${email})`;
  }

  function toggleDark() {
    document.body.classList.toggle("dark");
  }
</script>

</body>
</html>
