<div class="container py-4">
  <div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
      <div>
        <h2>Nhật ký Hoạt động (Audit Logs)</h2>
        <p class="text-muted">Theo dõi lịch sử thay đổi quan trọng trong hệ thống.</p>
      </div>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Thời gian</th>
              <th>Hành động</th>
              <th>Người thực hiện</th>
              <th>Chi tiết</th>
              <th>Mục tiêu tác động</th>
            </tr>
          </thead>
          <tbody>
            {{#if logs.length}}
              {{#each logs}}
              <tr>
                <td class="text-nowrap text-muted">{{this.createdAtStr}}</td>
                <td>
                  <span class="badge bg-secondary">{{this.action}}</span>
                </td>
                <td>
                  {{#if this.performedBy}}
                    <div class="fw-bold">{{this.performedBy.name}}</div>
                    <div class="small text-muted">{{this.performedBy.email}}</div>
                  {{else}}
                    --
                  {{/if}}
                </td>
                <td>{{this.details}}</td>
                <td>
                  {{#if this.targetUser}}
                    <div class="fw-bold">{{this.targetUser.name}}</div>
                  {{else}}
                    --
                  {{/if}}
                </td>
              </tr>
              {{/each}}
            {{else}}
              <tr>
                <td colspan="5" class="text-center py-4 text-muted">Chưa có nhật ký hoạt động nào.</td>
              </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
