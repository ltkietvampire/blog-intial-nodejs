<style>
body {
  background: #f7f8fc;
  font-family: system-ui, sans-serif;
}

/* CARD */
.profile-card {
  border-radius: 16px;
  background: white;
  box-shadow: 0 10px 30px rgba(0,0,0,.08);
  overflow: visible !important;
}

/* COVER */
.profile-cover {
  position: relative;
  height: 220px;
  background: #e5e7eb;
  overflow: visible;
  z-index: 1;
}
.container {
  overflow: visible;
}

/* COVER IMAGE */
.cover-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}

/* AVATAR WRAPPER */
.profile-avatar-wrapper {
  position: absolute;
  bottom: -50px; /* avatar overlaps body */
  left: 30px;
  z-index: 10;
}



/* AVATAR */
.profile-avatar {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  object-fit: cover;
  background: #fff;
}


/* AVATAR EDIT */
.avatar-edit {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,.5);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  cursor: pointer;
  transition: opacity .2s;
}

.profile-avatar-wrapper:hover .avatar-edit {
  opacity: 1;
}

/* COVER EDIT */
.cover-edit {
  position: absolute;
  right: 20px;
  bottom: 20px;
  background: rgba(0,0,0,.6);
  color: #fff;
  padding: 8px 12px;
  border-radius: 8px;
  cursor: pointer;
  z-index: 4;
  opacity: 0;
  transition: opacity .2s;
}

.profile-cover:hover .cover-edit {
  opacity: 1;
}

/* BODY */
.profile-body {
  padding: 70px 30px 30px;
}

/* TEXT */
.profile-name {
  font-size: 22px;
  font-weight: 600;
}

.profile-role {
  color: #6b7280;
  font-size: 14px;
}

.info-item i {
  color: #3b82f6;
  width: 20px;
}

/* STATS */
.stat-box {
  background: #f1f5ff;
  border-radius: 12px;
  padding: 16px;
  text-align: center;
}

.stat-box h5 {
  margin: 0;
  font-weight: 600;
}

.stat-box span {
  font-size: 13px;
  color: #6b7280;
}
  </style>

<div class="container py-5">
  <div class="profile-card">

    <!-- COVER -->
<div class="profile-cover">

  <!-- COVER IMAGE -->
  <img src="{{user.cover}}" class="cover-image" alt="">

  <!-- AVATAR -->
  <div class="profile-avatar-wrapper">
    <img src="{{user.avatar}}" class="profile-avatar">
    <div class="avatar-edit">
      <i class="bi bi-camera"></i>
    </div>
  </div>

  <!-- CHANGE COVER BUTTON -->
  <div class="cover-edit">
    <i class="bi bi-image"></i> Change cover image
  </div>

</div>





    <!-- BODY -->
    <div class="profile-body">

      <!-- BASIC INFO -->
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
          <div class="profile-name">{{user.name}}</div>
          <div class="profile-role">{{user.position}} · {{user.maxtime}}</div>
        </div>

        <div class="d-flex gap-2 align-items-start">
          <span class="badge bg-success align-self-start">
           {{user.trangthai}}
          </span>
          <div class="dropdown">
            <button
              class="btn btn-light btn-sm"
              type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
              aria-label="Profile actions"
            >
              <i class="bi bi-three-dots-vertical"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li>
                <button
                  type="button"
                  class="dropdown-item"
                  data-bs-toggle="modal"
                  data-bs-target="#editProfileModal"
                >
                  Edit profile
                </button>
              </li>
              <li>
                <button
                  type="button"
                  class="dropdown-item"
                  data-bs-toggle="modal"
                  data-bs-target="#changePasswordModal"
                >
                  Change password
                </button>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- CONTACT -->
      <div class="row mt-4">
        <div class="col-md-6 info-item mb-2">
          <i class="bi bi-envelope"></i>
{{user.email}}        </div>
        <div class="col-md-6 info-item mb-2">
          <i class="bi bi-telephone"></i>
{{user.SDT}}        </div>
        <div class="col-md-6 info-item mb-2">
          <i class="bi bi-building"></i>
{{user.state}}        </div>
        <div class="col-md-6 info-item mb-2">
          <i class="bi bi-calendar-event"></i>
          Joined: {{user.createdAt}}
        </div>
      </div>

      <!-- ABOUT -->
      <div class="mt-4">
        <h6 class="fw-semibold">About</h6>
        <p class="text-muted mb-0">
          {{user.introduce}}
        </p>
      </div>

      <!-- STATS -->
      <div class="row mt-4 g-3">
        <div class="col-md-4">
          <div class="stat-box">
            <h5>{{stats.inProgressTasks}}</h5>
            <span>Tasks in progress</span>
          </div>
        </div>
        <div class="col-md-4">
          <div class="stat-box">
            <h5>{{stats.completedTasks}}</h5>
            <span>Completed tasks</span>
          </div>
        </div>
        <div class="col-md-4">
          <div class="stat-box">
            <h5>{{stats.weeklyWorkHours}}h</h5>
            <span>Work hours this week</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<div class="modal fade" id="editProfileModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <form class="modal-content" method="POST" action="/auth/update-profile">
      <div class="modal-header">
        <h5 class="modal-title">Update profile information</h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Ho va ten</label>
            <input type="text" name="name" class="form-control" value="{{user.name}}" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-control" value="{{user.email}}" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">So dien thoai</label>
            <input type="text" name="SDT" class="form-control" value="{{user.SDT}}" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Area/Branch</label>
            <input type="text" name="state" class="form-control" value="{{user.state}}">
          </div>
          <div class="col-12">
            <label class="form-label">Introduction</label>
            <textarea name="introduce" class="form-control" rows="3">{{user.introduce}}</textarea>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save changes</button>
      </div>
    </form>
  </div>
</div>

<div class="modal fade" id="changePasswordModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" method="POST" action="/auth/change-password">
      <div class="modal-header">
        <h5 class="modal-title">Change password</h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">Current password</label>
          <input type="password" name="currentPassword" class="form-control" required>
        </div>
        <div class="mb-3">
          <label class="form-label">New password</label>
          <input type="password" name="newPassword" class="form-control" minlength="6" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Confirm new password</label>
          <input type="password" name="confirmPassword" class="form-control" minlength="6" required>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Update</button>
      </div>
    </form>
  </div>
</div>

<div class="modal fade" id="imageModal">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4">
      <div class="modal-header">
        <h5 class="modal-title">Update image</h5>
        <button class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form 
        id="submitForm"
        action="/auth/uploads-image-auth"
        method="POST"
        enctype="multipart/form-data"
      >
        <input type="hidden" name="type" id="imageType">

        <div class="modal-body text-center">
          <img id="imagePreview" class="img-fluid rounded mb-3" style="max-height:300px">
          <input
            type="file"
            name="image"
            id="imageInput"
            class="form-control"
            accept=".png,.jpg,.jpeg,.webp"
          >
        </div>

        <div class="modal-footer">
          <button type="reset" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>

    </div>
  </div>
</div>
<script>
      document.addEventListener('DOMContentLoaded', function () {

      let imageType = '';

      $('.avatar-edit').click(() => {
        imageType = 'avatar';
        $('#imageType').val('avatar');
        $('#imageModal').modal('show');
      });

      $('.cover-edit').click(() => {
        imageType = 'cover';
        $('#imageType').val('cover');
        $('#imageModal').modal('show');
      });


      $('#imageInput').change(function () {
        const file = this.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = e => {
          $('#imagePreview').attr('src', e.target.result);
        };
        reader.readAsDataURL(file);
      });

      })
</script>
