<style>
  :root {
    --bg: #f4f6fb;
    --card: #ffffff;
    --text: #1f2937;
    --muted: #6b7280;
    --primary: #2563eb;
  }

  .task-page {
    max-width: 1200px;
    margin: 28px auto;
  }

  .panel {
    background: #f8faff;
    border-radius: 16px;
    padding: 16px;
  }

  .task-card {
    border: 0;
    border-radius: 14px;
    background: var(--card);
    box-shadow: 0 8px 24px rgba(31, 41, 55, 0.08);
  }

  .priority-1 { border-left: 5px solid #ef4444; }
  .priority-2 { border-left: 5px solid #f97316; }
  .priority-3 { border-left: 5px solid #f59e0b; }
  .priority-4 { border-left: 5px solid #22c55e; }
  .priority-5 { border-left: 5px solid #3b82f6; }

  .small-muted {
    color: var(--muted);
    font-size: 13px;
  }

  .badge-soft {
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
    background: #e0ebff;
    color: #1d4ed8;
  }

  .btn-ghost {
    border: 0;
    background: transparent;
    color: #6b7280;
    border-radius: 8px;
    padding: 4px 8px;
  }

  .btn-ghost:hover {
    background: #f1f5f9;
    color: #111827;
  }
</style>

<div class="task-page">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h3 class="mb-0">Tasks</h3>
    <div class="d-flex gap-2 align-items-center">
      <input id="searchInput" class="form-control form-control-sm" style="max-width: 260px" placeholder="Search task name">
      <select id="filterPriority" class="form-select form-select-sm" style="width: 150px">
        <option value="all">All priorities</option>
        <option value="1">Priority 1</option>
        <option value="2">Priority 2</option>
        <option value="3">Priority 3</option>
        <option value="4">Priority 4</option>
        <option value="5">Priority 5</option>
      </select>
      <button id="btn-clear" class="btn btn-outline-secondary btn-sm">Clear</button>
      <button
        type="button"
        class="btn btn-outline-dark btn-sm"
        data-bs-toggle="modal"
        data-bs-target="#archivedTasksModal"
      >
        Archive/Completed ({{archivedTasks.length}})
      </button>
      <button id="btn-add" class="btn btn-primary btn-sm">New Task</button>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-6">
      <div class="panel">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h5 class="mb-0">Needs assignees</h5>
            <div class="small-muted">Tasks that still need assignees</div>
          </div>
          <span id="needCount" class="badge-soft">0</span>
        </div>
        <div id="needAssignList" class="d-grid gap-3"></div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="panel">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h5 class="mb-0">Assigned</h5>
            <div class="small-muted">List of already assigned employees</div>
          </div>
          <span id="assignedCount" class="badge-soft">0</span>
        </div>
        <div id="assignedList" class="d-grid gap-3"></div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="archivedTasksModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Archive/Completed Tasks</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead>
              <tr>
                <th>Task</th>
                <th>Recurrence</th>
                <th>Deadline</th>
                <th>People</th>
                <th>Completed At</th>
                <th>Archived At</th>
              </tr>
            </thead>
            <tbody>
              {{#if archivedTasks.length}}
                {{#each archivedTasks}}
                  <tr>
                    <td>
                      <div class="fw-semibold">{{this.name_task}}</div>
                      <div class="small-muted">{{this.description_task}}</div>
                    </td>
                    <td>{{this.recurrence_label}}</td>
                    <td>{{this.deadlineText}}</td>
                    <td>{{this.assigned_people_count}} / {{this.required_people}}</td>
                    <td>{{this.completedAtText}}</td>
                    <td>{{this.archivedAtText}}</td>
                  </tr>
                {{/each}}
              {{else}}
                <tr>
                  <td colspan="6" class="text-center text-muted py-4">
                    Chua co task archived.
                  </td>
                </tr>
              {{/if}}
            </tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="taskModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <form id="taskForm" class="modal-content" method="POST" action="/tasks/store">
      <div class="modal-header">
        <h5 class="modal-title">Create new task</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label fw-semibold">Task name</label>
          <input name="name_task" class="form-control" required>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Description</label>
          <textarea name="description_task" class="form-control" rows="2"></textarea>
        </div>
        <div class="row g-2 mb-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Start time</label>
            <input
              type="time"
              id="createDateStart"
              name="dateStart"
              class="form-control"
              min="08:00"
              max="19:00"
              step="60"
              value="08:00"
              required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">End time</label>
            <input
              type="time"
              id="createDateEnd"
              name="dateEnd"
              class="form-control"
              min="09:00"
              max="20:00"
              step="60"
              value="09:00"
              required>
          </div>
        </div>
        <div class="row g-2 mb-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Deadline</label>
            <input type="date" id="createDeadline" name="deadline" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Priority</label>
            <select name="priority" class="form-select">
              <option value="1">1 - Rat cao</option>
              <option value="2">2 - Cao</option>
              <option value="3" selected>3 - Trung binh</option>
              <option value="4">4 - Thap</option>
              <option value="5">5 - Rat thap</option>
            </select>
          </div>
        </div>
        <div class="row g-2">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Recurrence</label>
            <select name="recurrence_type" class="form-select">
              <option value="none" selected>No recurrence</option>
              <option value="daily">Hang ngay</option>
              <option value="weekly">Weekly</option>
              <option value="monthly">Monthly</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Required people</label>
            <input type="number" name="required_people" min="1" value="1" class="form-control" required>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save task</button>
      </div>
    </form>
  </div>
</div>

<div class="modal fade" id="taskEditModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <form id="taskEditForm" class="modal-content" method="POST">
      <div class="modal-header">
        <h5 class="modal-title">Edit task</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label fw-semibold">Task name</label>
          <input id="editNameTask" name="name_task" class="form-control" required>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Description</label>
          <textarea id="editDescriptionTask" name="description_task" class="form-control" rows="2"></textarea>
        </div>
        <div class="row g-2 mb-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Start time</label>
            <input type="time" id="editDateStart" name="dateStart" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">End time</label>
            <input type="time" id="editDateEnd" name="dateEnd" class="form-control" required>
          </div>
        </div>
        <div class="row g-2 mb-3">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Deadline</label>
            <input type="date" id="editDeadline" name="deadline" class="form-control" required>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Priority</label>
            <select id="editPriority" name="priority" class="form-select">
              <option value="1">1 - Rat cao</option>
              <option value="2">2 - Cao</option>
              <option value="3">3 - Trung binh</option>
              <option value="4">4 - Thap</option>
              <option value="5">5 - Rat thap</option>
            </select>
          </div>
        </div>
        <div class="row g-2">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Recurrence</label>
            <select id="editRecurrenceType" name="recurrence_type" class="form-select">
              <option value="none">No recurrence</option>
              <option value="daily">Hang ngay</option>
              <option value="weekly">Weekly</option>
              <option value="monthly">Monthly</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Required people</label>
            <input type="number" id="editRequiredPeople" name="required_people" min="1" class="form-control" required>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save changes</button>
      </div>
    </form>
  </div>
</div>

<div class="modal fade" id="deleteConfirmModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Delete task</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        Are you sure you want to delete task: <strong id="deleteTaskName"></strong>?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="assignTaskModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Assign task</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="p-3 rounded-3 mb-3" style="background:#f8fafc">
          <div class="fw-semibold mb-1" id="assignTaskName">Ten task</div>
          <div class="small-muted" id="assignTaskInfo">00:00 - 00:00</div>
          <div class="small-muted mt-1" id="assignTaskSlots">Con trong: 0</div>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Loc theo chuc vu</label>
          <select id="filterPosition" class="form-select">
            <option value="all">Tat ca</option>
            {{#each position}}
              <option value="{{this}}">{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div class="mb-2">
          <label class="form-label fw-semibold">Employee</label>
          <select id="assignEmployeeSelect" class="form-select" size="6" required></select>
          <div class="invalid-feedback">Please select an employee.</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="confirmAssignBtn">Assign task</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="unassignModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Unassign phan cong</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        Unassign task cua <strong id="unassignUserName"></strong>?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirmUnassignBtn">Unassign</button>
      </div>
    </div>
  </div>
</div>

<form method="POST" id="actionForm"></form>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('searchInput');
    const filterPriority = document.getElementById('filterPriority');
    const needAssignList = document.getElementById('needAssignList');
    const assignedList = document.getElementById('assignedList');
    const needCount = document.getElementById('needCount');
    const assignedCount = document.getElementById('assignedCount');
    const btnAdd = document.getElementById('btn-add');
    const btnClear = document.getElementById('btn-clear');
    const taskForm = document.getElementById('taskForm');
    const createDateStart = document.getElementById('createDateStart');
    const createDateEnd = document.getElementById('createDateEnd');
    const createDeadline = document.getElementById('createDeadline');

    const taskModal = new bootstrap.Modal(document.getElementById('taskModal'));
    const editModal = new bootstrap.Modal(document.getElementById('taskEditModal'));
    const deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
    const assignModal = new bootstrap.Modal(document.getElementById('assignTaskModal'));
    const unassignModal = new bootstrap.Modal(document.getElementById('unassignModal'));

    const actionForm = document.getElementById('actionForm');
    const users = {{{json users}}} || [];
    const recurrenceLabel = {
      none: 'No recurrence',
      daily: 'Hang ngay',
      weekly: 'Weekly',
      monthly: 'Monthly',
    };

    const escapeHtml = (value) => String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');

    const escapeAttr = (value) => escapeHtml(value);

    const safePriority = (value) => {
      const parsed = Number.parseInt(value, 10);
      return parsed >= 1 && parsed <= 5 ? parsed : 3;
    };

    const toMinuteOfDay = (timeValue) => {
      const [h, m] = String(timeValue || '').split(':').map(Number);
      if (!Number.isFinite(h) || !Number.isFinite(m)) return NaN;
      return h * 60 + m;
    };

    const rawTasks = {{{json tasks}}} || [];
    const rawData = {{{json data}}} || [];

    let currentAssignTaskId = '';
    let currentUnassignTaskId = '';
    let currentUnassignDistributionId = '';
    let currentAssignedEmployeeIds = [];
    let currentRemainingSlots = 0;

    const normalizeTask = (task) => {
      const required = Number.parseInt(task.required_people, 10);
      const assigned = Number.parseInt(task.assigned_people_count, 10);
      const recurrence = String(task.recurrence_type || 'none').toLowerCase();

      return {
        ...task,
        required_people: Number.isFinite(required) && required > 0 ? required : 1,
        assigned_people_count: Number.isFinite(assigned) && assigned >= 0 ? assigned : 0,
        recurrence_type: recurrenceLabel[recurrence] ? recurrence : 'none',
      };
    };

    let tasks = rawTasks.map(normalizeTask);

    const assignmentRows = rawData
      .filter((row) => row && row.taskID && row.employeeID)
      .map((row) => ({
        distributionId: String(row._id),
        taskId: String(row.taskID._id),
        employeeId: String(row.employeeID._id),
        employeeName: row.employeeID.name || 'No name',
        employeeAvatar: row.employeeID.avatar || '/img/default-avatar.webp',
        taskName: row.taskID.name_task || 'No name',
        dateStart: row.taskID.dateStart || '--:--',
        dateEnd: row.taskID.dateEnd || '--:--',
        deadline: row.taskID.deadline ? String(row.taskID.deadline).slice(0, 10) : '--',
        priority: Number.parseInt(row.taskID.priority, 10) || 3,
      }));

    const countByTask = {};
    for (const row of assignmentRows) {
      countByTask[row.taskId] = (countByTask[row.taskId] || 0) + 1;
    }

    tasks = tasks.map((task) => {
      const taskId = String(task._id);
      const actualAssigned = countByTask[taskId] || 0;
      return {
        ...task,
        assigned_people_count: actualAssigned,
      };
    });

    const refreshedTaskMap = new Map(tasks.map((task) => [String(task._id), task]));

    function fillAssignEmployeeSelect() {
      const select = document.getElementById('assignEmployeeSelect');
      const filterPosition = document.getElementById('filterPosition').value;
      select.innerHTML = '';
      select.classList.remove('is-invalid');

      const availableUsers = users.filter((user) => {
        if (filterPosition !== 'all' && user.position !== filterPosition) {
          return false;
        }
        return !currentAssignedEmployeeIds.includes(String(user._id));
      });

      for (const user of availableUsers) {
        const option = document.createElement('option');
        option.value = String(user._id);
        option.textContent = `${user.name} - ${user.position}`;
        select.appendChild(option);
      }
    }

    function renderNeedAssignTask(task) {
      const taskId = String(task._id);
      const remain = Math.max(task.required_people - task.assigned_people_count, 0);
      const deadlineText = task.deadline ? String(task.deadline).slice(0, 10) : '--';
      const recurrenceText = recurrenceLabel[task.recurrence_type] || recurrenceLabel.none;
      const priorityClass = safePriority(task.priority);

      const safeTaskId = escapeAttr(taskId);
      const safeTaskName = escapeHtml(task.name_task || 'No name');
      const safeTaskDescription = escapeHtml(task.description_task || 'No description');
      const safeDateStart = escapeHtml(task.dateStart || '--:--');
      const safeDateEnd = escapeHtml(task.dateEnd || '--:--');
      const safeDeadline = escapeHtml(deadlineText);
      const safeRecurrence = escapeHtml(recurrenceText);
      const safeEstimatedHours = escapeHtml(task.estimated_total_hours || 0);
      const safeAssigned = escapeHtml(task.assigned_people_count || 0);
      const safeRequired = escapeHtml(task.required_people || 1);
      const safeRemain = escapeHtml(remain);

      return `
        <div class="card task-card priority-${priorityClass}">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div>
                <h6 class="mb-1">${safeTaskName}</h6>
                <div class="small-muted">${safeDateStart} - ${safeDateEnd} | ${safeEstimatedHours}h</div>
                <div class="small-muted">Deadline: ${safeDeadline}</div>
                <div class="small-muted">Chu ky: ${safeRecurrence}</div>
                <div class="small-muted">Da giao: ${safeAssigned}/${safeRequired} nguoi</div>
                <div class="small-muted">Con thieu: ${safeRemain} nguoi</div>
              </div>
              <div class="d-flex flex-column align-items-end gap-1">
                <button class="btn-ghost btn-edit-task"
                  data-id="${safeTaskId}"
                  data-name="${escapeAttr(task.name_task || '')}"
                  data-description="${escapeAttr(task.description_task || '')}"
                  data-priority="${priorityClass}"
                  data-deadline="${escapeAttr(deadlineText)}"
                  data-start="${escapeAttr(task.dateStart || '')}"
                  data-end="${escapeAttr(task.dateEnd || '')}"
                  data-recurrence="${escapeAttr(task.recurrence_type || 'none')}"
                  data-required="${escapeAttr(task.required_people || 1)}"
                  title="Edit task">
                  <i class="bi bi-pencil"></i>
                </button>
                <button class="btn-ghost btn-delete-task" data-id="${safeTaskId}" data-name="${escapeAttr(task.name_task || '')}" title="Delete task">
                  <i class="bi bi-trash"></i>
                </button>
                ${remain > 0 ? `
                  <button class="btn-ghost btn-assign-task"
                    data-id="${safeTaskId}"
                    data-name="${escapeAttr(task.name_task || '')}"
                    data-start="${escapeAttr(task.dateStart || '')}"
                    data-end="${escapeAttr(task.dateEnd || '')}"
                    data-deadline="${escapeAttr(deadlineText)}"
                    data-required="${escapeAttr(task.required_people || 1)}"
                    data-assigned="${escapeAttr(task.assigned_people_count || 0)}"
                    title="Assign task">
                    <i class="bi bi-person-plus"></i>
                  </button>
                ` : ''}
              </div>
            </div>
            <p class="mb-0 mt-2 small-muted">${safeTaskDescription}</p>
          </div>
        </div>
      `;
    }

    function renderAssignedRow(row) {
      const task = refreshedTaskMap.get(row.taskId);
      const assigned = task ? task.assigned_people_count : 0;
      const required = task ? task.required_people : 1;
      const recurrence = task ? (recurrenceLabel[task.recurrence_type] || recurrenceLabel.none) : recurrenceLabel.none;
      const deadlineText = task && task.deadline ? String(task.deadline).slice(0, 10) : row.deadline;
      const priorityClass = safePriority(row.priority);

      const safeTaskId = escapeAttr(row.taskId);
      const safeDistributionId = escapeAttr(row.distributionId);
      const safeTaskName = escapeHtml(row.taskName || 'No name');
      const safeDateStart = escapeHtml(row.dateStart || '--:--');
      const safeDateEnd = escapeHtml(row.dateEnd || '--:--');
      const safeDeadline = escapeHtml(deadlineText || '--');
      const safeRecurrence = escapeHtml(recurrence);
      const safeAssigned = escapeHtml(assigned);
      const safeRequired = escapeHtml(required);
      const safeEmployeeName = escapeHtml(row.employeeName || 'No name');
      const safeEmployeeAvatar = escapeAttr(row.employeeAvatar || '/img/default-avatar.webp');

      return `
        <div class="card task-card priority-${priorityClass}">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <div>
                <h6 class="mb-1">${safeTaskName}</h6>
                <div class="small-muted">${safeDateStart} - ${safeDateEnd} | Deadline: ${safeDeadline}</div>
                <div class="small-muted">Chu ky: ${safeRecurrence}</div>
                <div class="small-muted">Tien do giao: ${safeAssigned}/${safeRequired} nguoi</div>
                <div class="d-flex align-items-center gap-2 mt-1">
                  <img src="${safeEmployeeAvatar}" class="rounded-circle" width="24" height="24">
                  <span class="small-muted">${safeEmployeeName}</span>
                </div>
              </div>
              <div class="d-flex flex-column align-items-end gap-1">
                <button class="btn-ghost btn-edit-task"
                  data-id="${safeTaskId}"
                  data-name="${escapeAttr(task ? (task.name_task || '') : (row.taskName || ''))}"
                  data-description="${escapeAttr(task ? (task.description_task || '') : '')}"
                  data-priority="${escapeAttr(task ? (task.priority || 3) : priorityClass)}"
                  data-deadline="${escapeAttr(deadlineText || '')}"
                  data-start="${escapeAttr(task ? (task.dateStart || '') : (row.dateStart || ''))}"
                  data-end="${escapeAttr(task ? (task.dateEnd || '') : (row.dateEnd || ''))}"
                  data-recurrence="${escapeAttr(task ? (task.recurrence_type || 'none') : 'none')}"
                  data-required="${escapeAttr(task ? (task.required_people || 1) : 1)}"
                  title="Edit task">
                  <i class="bi bi-pencil"></i>
                </button>
                <button class="btn-ghost btn-delete-task" data-id="${safeTaskId}" data-name="${escapeAttr(row.taskName || '')}" title="Delete task">
                  <i class="bi bi-trash"></i>
                </button>
                <button class="btn-ghost btn-unassign-task"
                  data-task-id="${safeTaskId}"
                  data-distribution-id="${safeDistributionId}"
                  data-user-name="${escapeAttr(row.employeeName || '')}"
                  title="Unassign">
                  <i class="bi bi-person-dash"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      `;
    }

    function bindDynamicActions() {
      document.querySelectorAll('.btn-edit-task').forEach((btn) => {
        btn.addEventListener('click', function () {
          document.getElementById('editNameTask').value = this.dataset.name || '';
          document.getElementById('editDescriptionTask').value = this.dataset.description || '';
          document.getElementById('editPriority').value = this.dataset.priority || '3';
          document.getElementById('editDeadline').value = this.dataset.deadline || '';
          document.getElementById('editDateStart').value = this.dataset.start || '';
          document.getElementById('editDateEnd').value = this.dataset.end || '';
          document.getElementById('editRecurrenceType').value = this.dataset.recurrence || 'none';
          document.getElementById('editRequiredPeople').value = this.dataset.required || '1';
          document.getElementById('taskEditForm').action = `/tasks/${this.dataset.id}?_method=PUT`;
          editModal.show();
        });
      });

      document.querySelectorAll('.btn-delete-task').forEach((btn) => {
        btn.addEventListener('click', function () {
          document.getElementById('deleteTaskName').textContent = this.dataset.name || '';
          actionForm.action = `/tasks/${this.dataset.id}?_method=DELETE`;
          deleteModal.show();
        });
      });

      document.querySelectorAll('.btn-assign-task').forEach((btn) => {
        btn.addEventListener('click', function () {
          currentAssignTaskId = this.dataset.id;
          const required = Number.parseInt(this.dataset.required, 10) || 1;
          const assigned = Number.parseInt(this.dataset.assigned, 10) || 0;
          currentRemainingSlots = Math.max(required - assigned, 0);

          currentAssignedEmployeeIds = assignmentRows
            .filter((row) => row.taskId === currentAssignTaskId)
            .map((row) => row.employeeId);

          document.getElementById('assignTaskName').textContent = this.dataset.name || '';
          document.getElementById('assignTaskInfo').textContent =
            `${this.dataset.start || '--:--'} - ${this.dataset.end || '--:--'} | Deadline: ${this.dataset.deadline || '--'}`;
          document.getElementById('assignTaskSlots').textContent =
            `Can ${required} nguoi, da giao ${assigned}, con trong ${currentRemainingSlots}`;

          fillAssignEmployeeSelect();
          assignModal.show();
        });
      });

      document.querySelectorAll('.btn-unassign-task').forEach((btn) => {
        btn.addEventListener('click', function () {
          currentUnassignTaskId = this.dataset.taskId;
          currentUnassignDistributionId = this.dataset.distributionId;
          document.getElementById('unassignUserName').textContent = this.dataset.userName || '';
          unassignModal.show();
        });
      });
    }

    function render() {
      needAssignList.innerHTML = '';
      assignedList.innerHTML = '';

      const keyword = String(searchInput.value || '').trim().toLowerCase();
      const priorityFilter = filterPriority.value;

      const needTasks = tasks
        .filter((task) => task.assigned_people_count < task.required_people)
        .filter((task) => {
          if (priorityFilter !== 'all' && String(task.priority) !== priorityFilter) {
            return false;
          }
          if (keyword && !String(task.name_task || '').toLowerCase().includes(keyword)) {
            return false;
          }
          return true;
        })
        .sort((a, b) => {
          if (a.priority !== b.priority) {
            return a.priority - b.priority;
          }
          return new Date(b.createdAt) - new Date(a.createdAt);
        });

      const assignedRows = assignmentRows
        .filter((row) => {
          if (priorityFilter !== 'all' && String(row.priority) !== priorityFilter) {
            return false;
          }
          if (keyword && !String(row.taskName || '').toLowerCase().includes(keyword)) {
            return false;
          }
          return true;
        })
        .sort((a, b) => {
          if (a.priority !== b.priority) {
            return a.priority - b.priority;
          }
          return String(a.taskName).localeCompare(String(b.taskName));
        });

      needCount.textContent = String(needTasks.length);
      assignedCount.textContent = String(assignedRows.length);

      if (needTasks.length === 0) {
        needAssignList.innerHTML = '<div class="alert alert-light border mb-0">No tasks require additional assignees.</div>';
      } else {
        for (const task of needTasks) {
          needAssignList.insertAdjacentHTML('beforeend', renderNeedAssignTask(task));
        }
      }

      if (assignedRows.length === 0) {
        assignedList.innerHTML = '<div class="alert alert-light border mb-0">Chua co phan cong task.</div>';
      } else {
        for (const row of assignedRows) {
          assignedList.insertAdjacentHTML('beforeend', renderAssignedRow(row));
        }
      }

      bindDynamicActions();
    }

    document.getElementById('confirmDeleteBtn').onclick = function () {
      actionForm.submit();
    };

    document.getElementById('confirmAssignBtn').onclick = function () {
      const select = document.getElementById('assignEmployeeSelect');
      if (!currentAssignTaskId || currentRemainingSlots <= 0) {
        return;
      }
      if (!select.value) {
        select.classList.add('is-invalid');
        select.focus();
        return;
      }
      actionForm.action = `/tasks/${currentAssignTaskId}/${select.value}`;
      actionForm.submit();
    };

    document.getElementById('confirmUnassignBtn').onclick = function () {
      if (!currentUnassignTaskId || !currentUnassignDistributionId) {
        return;
      }
      actionForm.action = `/tasks/${currentUnassignTaskId}/${currentUnassignDistributionId}?_method=DELETE`;
      actionForm.submit();
    };

    document.getElementById('filterPosition').onchange = fillAssignEmployeeSelect;
    document.getElementById('assignEmployeeSelect').onchange = function () {
      this.classList.remove('is-invalid');
    };

    if (createDeadline) {
      const now = new Date();
      const localToday = new Date(now.getTime() - now.getTimezoneOffset() * 60000)
        .toISOString()
        .slice(0, 10);
      createDeadline.min = localToday;
      if (!createDeadline.value) {
        createDeadline.value = localToday;
      }
    }

    if (taskForm) {
      taskForm.addEventListener('submit', function (e) {
        const startValue = createDateStart ? createDateStart.value : '';
        const endValue = createDateEnd ? createDateEnd.value : '';
        const deadlineValue = createDeadline ? createDeadline.value : '';

        if (!startValue || !endValue || !deadlineValue) {
          return;
        }

        const startMinutes = toMinuteOfDay(startValue);
        const endMinutes = toMinuteOfDay(endValue);

        if (!Number.isFinite(startMinutes) || !Number.isFinite(endMinutes) || endMinutes <= startMinutes) {
          e.preventDefault();
          alert('End time phai lon hon gio bat dau.');
          return;
        }

        if (createDeadline.min && deadlineValue < createDeadline.min) {
          e.preventDefault();
          alert('Deadline must be today or later.');
        }
      });
    }

    btnAdd.onclick = () => taskModal.show();
    btnClear.onclick = () => {
      searchInput.value = '';
      filterPriority.value = 'all';
      render();
    };
    filterPriority.onchange = render;
    searchInput.oninput = render;

    render();
  });
</script>

