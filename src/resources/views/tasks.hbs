<div class="tasks-view">
  <div class="task-page">
    <div class="d-flex align-items-center justify-content-between mb-3 toolbar gap-2 flex-wrap">
      <h3 class="mb-0">Tasks</h3>
      <div class="d-flex gap-2 align-items-center flex-wrap">
        <button
          type="button"
          class="btn btn-outline-dark btn-sm"
          data-bs-toggle="modal"
          data-bs-target="#archivedTasksModal"
        >
          Archive/Completed ({{archivedTasks.length}})
        </button>
        <button id="btn-add" class="btn btn-primary btn-sm">+ New Task</button>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-6">
        <div class="section-box">
          <div class="d-flex align-items-center mb-3">
            <div>
              <h5 class="mb-0">Unassigned</h5>
              <div class="small-muted">Ascending priority, newest tasks first</div>
            </div>
            <div class="ms-auto d-flex align-items-center gap-2">
              <span id="unassignedCount" class="badge-soft">0</span>
              <select id="filterPriority" class="form-select form-select-sm" style="width: 160px">
                <option value="all">All priorities</option>
                <option value="1">Priority 1</option>
                <option value="2">Priority 2</option>
                <option value="3">Priority 3</option>
                <option value="4">Priority 4</option>
                <option value="5">Priority 5</option>
              </select>
            </div>
          </div>
          <div id="unassignedList" class="list-group list-group-flush"></div>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="section-box">
          <div class="d-flex align-items-center mb-3">
            <div>
              <h5 class="mb-0">Assigned</h5>
              <div class="small-muted">Grouped by assignee and deadline</div>
            </div>
            <span id="assignedCount" class="badge-soft ms-auto">0</span>
          </div>
          <div id="assignedList" class="list-group list-group-flush"></div>
        </div>
      </div>
    </div>
  </div>

  <form method="POST" id="actionForm"></form>

  {{> tasks-modals}}

  <script>
    window.usersData = {{{json users}}};
    window.tasksData = {{{json tasks}}};
    window.assignmentsData = {{{json data}}};
  </script>
  <script src="/js/tasks.js"></script>
</div>
