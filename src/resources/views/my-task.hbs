<div class="my-task-view">
{{> comments-modal}}
<div class="container py-4 mytask-wrap">
  <div class="mytask-header mb-4">
    <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
      <div>
        <h3 class="mytask-title">{{t 'myTask.title'}}</h3>
        <div class="mytask-sub">{{t 'myTask.updated'}} {{nowText}}</div>
      </div>

      <div class="text-end">
        <div class="mytask-sub">{{t 'myTask.employee'}}</div>
        <div class="fw-semibold">{{user.name}} - {{user.position}}</div>
        <div class="mytask-sub">{{t 'myTask.totalWorkedTime'}} {{user.totalWorkingHours}}h</div>
      </div>
    </div>
  </div>

  <div class="mb-4">
    <div class="d-flex justify-content-between align-items-end mb-3">
      <div>
        <h5 class="section-title">{{t 'myTask.todayTasks'}}</h5>
        <div class="section-sub">{{t 'myTask.todayTasksSub'}}</div>
      </div>
      <div class="section-sub">{{t 'myTask.total'}} {{todayTasks.length}}</div>
    </div>

    <div class="row g-3">
      {{#if todayTasks.length}}
        {{#each todayTasks}}
          <div class="col-lg-4 col-md-6">
            <div class="card task-card p-3">
              <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                <div class="fw-semibold">{{this.name}}</div>
                <span class="status-pill {{this.statusClass}}">{{this.statusLabel}}</span>
              </div>

              <div class="task-time">{{this.dateStart}} - {{this.dateEnd}}</div>
              <div class="task-desc">{{this.description}}</div>

              <div class="meta-text mt-2">{{t 'myTask.deadline'}} {{this.deadlineText}}</div>
              <div class="meta-text">{{t 'myTask.estimatedHours'}} {{this.estimatedHours}}h</div>
              {{#if this.checkInAtText}}
                <div class="meta-text">{{t 'myTask.checkIn'}} {{this.checkInAtText}}</div>
              {{/if}}
              {{#if this.completedAtText}}
                <div class="meta-text">{{t 'myTask.completed'}} {{this.completedAtText}}</div>
              {{/if}}

              <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="button" class="btn btn-outline-secondary btn-sm btn-comments-task" data-id="{{this.taskId}}" data-name="{{this.name}}">
                  <i class="bi bi-chat-dots-fill"></i> {{t 'myTask.discussReport'}}
                </button>
                {{#if this.canCheckIn}}
                  <form method="POST" action="/my-task/{{this.distributionId}}/check-in">
                    <button type="submit" class="btn btn-outline-primary btn-sm">{{t 'myTask.btnCheckIn'}}</button>
                  </form>
                {{/if}}

                {{#if this.canComplete}}
                  <form method="POST" action="/my-task/{{this.distributionId}}/complete">
                    <button type="submit" class="btn btn-success btn-sm">{{t 'myTask.btnComplete'}}</button>
                  </form>
                {{/if}}
              </div>
            </div>
          </div>
        {{/each}}
      {{else}}
        <div class="col-12">
          <div class="alert alert-light border mb-0">{{t 'myTask.noTasksToday'}}</div>
        </div>
      {{/if}}
    </div>
  </div>

  <div class="mb-4">
    <div class="d-flex justify-content-between align-items-end mb-3">
      <div>
        <h5 class="section-title">{{t 'myTask.upcomingTasks'}}</h5>
        <div class="section-sub">{{t 'myTask.upcomingTasksSub'}}</div>
      </div>
      <div class="section-sub">{{t 'myTask.total'}} {{upcomingTasks.length}}</div>
    </div>

    <div class="row g-3">
      {{#if upcomingTasks.length}}
        {{#each upcomingTasks}}
          <div class="col-lg-4 col-md-6">
            <div class="card task-card p-3">
              <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                <div class="fw-semibold">{{this.name}}</div>
                <span class="status-pill {{this.statusClass}}">{{this.statusLabel}}</span>
              </div>

              <div class="task-time">{{this.dateStart}} - {{this.dateEnd}}</div>
              <div class="task-desc">{{this.description}}</div>

              <div class="meta-text mt-2">{{t 'myTask.deadline'}} {{this.deadlineText}}</div>
              <div class="meta-text">{{t 'myTask.estimatedHours'}} {{this.estimatedHours}}h</div>
              {{#if this.checkInAtText}}
                <div class="meta-text">{{t 'myTask.checkIn'}} {{this.checkInAtText}}</div>
              {{/if}}
              {{#if this.completedAtText}}
                <div class="meta-text">{{t 'myTask.completed'}} {{this.completedAtText}}</div>
              {{/if}}

              <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="button" class="btn btn-outline-secondary btn-sm btn-comments-task" data-id="{{this.taskId}}" data-name="{{this.name}}">
                  <i class="bi bi-chat-dots-fill"></i> {{t 'myTask.discussReport'}}
                </button>
              </div>
            </div>
          </div>
        {{/each}}
      {{else}}
        <div class="col-12">
          <div class="alert alert-light border mb-0">{{t 'myTask.noUpcomingTasks'}}</div>
        </div>
      {{/if}}
    </div>
  </div>

  <div class="mb-2">
    <div class="d-flex justify-content-between align-items-end mb-3">
      <div>
        <h5 class="section-title text-danger">{{t 'myTask.overdueTasks'}}</h5>
        <div class="section-sub">{{t 'myTask.overdueTasksSub'}}</div>
      </div>
      <div class="section-sub">{{t 'myTask.total'}} {{overdueTasks.length}}</div>
    </div>

    <div class="row g-3">
      {{#if overdueTasks.length}}
        {{#each overdueTasks}}
          <div class="col-lg-4 col-md-6">
            <div class="card task-card p-3 border border-danger-subtle">
              <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                <div class="fw-semibold">{{this.name}}</div>
                <span class="status-pill {{this.statusClass}}">{{this.statusLabel}}</span>
              </div>

              <div class="task-time">{{this.dateStart}} - {{this.dateEnd}}</div>
              <div class="task-desc">{{this.description}}</div>

              <div class="meta-text mt-2">{{t 'myTask.deadline'}} {{this.deadlineText}}</div>
              <div class="meta-text">{{t 'myTask.estimatedHours'}} {{this.estimatedHours}}h</div>
              {{#if this.checkInAtText}}
                <div class="meta-text">{{t 'myTask.checkIn'}} {{this.checkInAtText}}</div>
              {{/if}}

              <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="button" class="btn btn-outline-secondary btn-sm btn-comments-task" data-id="{{this.taskId}}" data-name="{{this.name}}">
                  <i class="bi bi-chat-dots-fill"></i> {{t 'myTask.discussReport'}}
                </button>
                {{#if this.canComplete}}
                  <form method="POST" action="/my-task/{{this.distributionId}}/complete">
                    <button type="submit" class="btn btn-success btn-sm">{{t 'myTask.btnComplete'}}</button>
                  </form>
                {{/if}}
              </div>
            </div>
          </div>
        {{/each}}
      {{else}}
        <div class="col-12">
          <div class="alert alert-light border mb-0">{{t 'myTask.noOverdueTasks'}}</div>
        </div>
      {{/if}}
    </div>
  </div>
</div>
</div>
