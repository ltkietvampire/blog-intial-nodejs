<div class="my-schedule-view">
  <div class="container py-4 my-schedule-wrap">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
      <div>
        <h3 class="mb-1">My Schedule</h3>
        <div class="text-muted">{{user.name}} - {{user.position}}</div>
      </div>
      <div class="d-flex gap-2 align-items-center">
        <small class="text-muted">Updated: {{nowText}}</small>
        <a href="/my-task" class="btn btn-outline-primary btn-sm">My Tasks</a>
      </div>
    </div>

    <div class="schedule-box">
      <div class="week-bar">
        <button type="button" onclick="prevWeek()">Prev</button>
        <strong id="weekLabel"></strong>
        <button type="button" onclick="nextWeek()">Next</button>
      </div>

      <div class="calendar">
        <div class="calendar-header calendar-grid">
          <div>Time</div>
          <div></div>
          <div></div>
          <div></div>
          <div></div>
          <div></div>
          <div></div>
          <div></div>
        </div>

        <div class="calendar-body calendar-grid">
          <div class="time-col">
            <div class="time-row">08:00</div>
            <div class="time-row">09:00</div>
            <div class="time-row">10:00</div>
            <div class="time-row">11:00</div>
            <div class="time-row">12:00</div>
            <div class="time-row">13:00</div>
            <div class="time-row">14:00</div>
            <div class="time-row">15:00</div>
            <div class="time-row">16:00</div>
            <div class="time-row">17:00</div>
            <div class="time-row">18:00</div>
            <div class="time-row">19:00</div>
            <div class="time-row">20:00</div>
          </div>

          <div class="day-col" id="day-2"></div>
          <div class="day-col" id="day-3"></div>
          <div class="day-col" id="day-4"></div>
          <div class="day-col" id="day-5"></div>
          <div class="day-col" id="day-6"></div>
          <div class="day-col" id="day-7"></div>
          <div class="day-col" id="day-8"></div>
        </div>
      </div>
    </div>

    {{> my-schedule-modals}}
  </div>

  <script>
    window.scheduleData = {{{json scheduleData}}};
  </script>
  <script src="/js/my-schedule.js"></script>
</div>
