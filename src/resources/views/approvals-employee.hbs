<div class="approvals-employee-view">
<div class="container py-4 approval-wrap">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
      <h3 class="mb-1">{{t 'approvalsEmployee.title'}}</h3>
      <div class="small-muted">{{t 'approvalsEmployee.subtitle'}}</div>
    </div>
    <a href="/dashboard" class="btn btn-outline-secondary btn-sm">{{t 'approvalsEmployee.btnBack'}}</a>
  </div>

  <div class="card card-soft mb-4">
    <div class="card-body">
      <h5 class="mb-3">{{t 'approvalsEmployee.createTitle'}}</h5>
      <form method="POST" action="/approvals/request" id="approvalForm">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">{{t 'approvalsEmployee.reqType'}}</label>
            <select class="form-select" name="requestType" id="requestType" required>
              <option value="leave">{{t 'approvalsEmployee.reqLeave'}}</option>
              <option value="shift_change">{{t 'approvalsEmployee.reqShift'}}</option>
              <option value="deadline_extension">{{t 'approvalsEmployee.reqDeadline'}}</option>
            </select>
          </div>
          <div class="col-md-8">
            <label class="form-label">{{t 'approvalsEmployee.reason'}}</label>
            <input class="form-control" name="reason" minlength="6" required placeholder="{{t 'approvalsEmployee.reasonPlaceholder'}}">
          </div>
        </div>

        <div id="leaveFields" class="row g-3 mt-1">
          <div class="col-md-6">
            <label class="form-label">{{t 'approvalsEmployee.fromDate'}}</label>
            <input type="date" class="form-control" name="requestedFromDate" value="{{todayDate}}">
          </div>
          <div class="col-md-6">
            <label class="form-label">{{t 'approvalsEmployee.toDate'}}</label>
            <input type="date" class="form-control" name="requestedToDate" value="{{todayDate}}">
          </div>
        </div>

        <div id="shiftFields" class="row g-3 mt-1 d-none">
          <div class="col-md-3">
            <label class="form-label">{{t 'approvalsEmployee.date'}}</label>
            <input type="date" class="form-control" name="requestedDate" value="{{todayDate}}">
          </div>
          <div class="col-md-3">
            <label class="form-label">{{t 'approvalsEmployee.currentStart'}}</label>
            <input type="time" class="form-control" name="currentTimeStart">
          </div>
          <div class="col-md-3">
            <label class="form-label">{{t 'approvalsEmployee.currentEnd'}}</label>
            <input type="time" class="form-control" name="currentTimeEnd">
          </div>
          <div class="col-md-3">
            <label class="form-label">{{t 'approvalsEmployee.reqStart'}}</label>
            <input type="time" class="form-control" name="requestedTimeStart">
          </div>
          <div class="col-md-3">
            <label class="form-label">{{t 'approvalsEmployee.reqEnd'}}</label>
            <input type="time" class="form-control" name="requestedTimeEnd">
          </div>
        </div>

        <div id="deadlineFields" class="row g-3 mt-1 d-none">
          <div class="col-md-6">
            <label class="form-label">{{t 'approvalsEmployee.task'}}</label>
            <select class="form-select" name="taskID">
              <option value="">{{t 'approvalsEmployee.selectTask'}}</option>
              {{#each assignedTasks}}
                <option value="{{this._id}}">{{this.name_task}} (deadline: {{this.deadlineText}})</option>
              {{/each}}
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label">{{t 'approvalsEmployee.reqDeadlineDate'}}</label>
            <input type="date" class="form-control" name="requestedDeadline" value="{{todayDate}}">
          </div>
        </div>

        <div class="mt-3">
          <button class="btn btn-primary" type="submit">{{t 'approvalsEmployee.btnSend'}}</button>
        </div>
      </form>
    </div>
  </div>

  <div class="card card-soft">
    <div class="card-body">
      <h5 class="mb-3">{{t 'approvalsEmployee.historyTitle'}}</h5>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>{{t 'approvalsEmployee.thCreated'}}</th>
              <th>{{t 'approvalsEmployee.thType'}}</th>
              <th>{{t 'approvalsEmployee.thDetail'}}</th>
              <th>{{t 'approvalsEmployee.thStatus'}}</th>
              <th>{{t 'approvalsEmployee.thManagerNote'}}</th>
            </tr>
          </thead>
          <tbody>
            {{#if requestRows.length}}
              {{#each requestRows}}
                <tr>
                  <td>{{this.createdAtText}}</td>
                  <td>{{this.requestTypeLabel}}</td>
                  <td>
                    <div><strong>{{t 'approvalsEmployee.lblReason'}}</strong> {{this.reason}}</div>
                    {{#if this.taskName}}<div><strong>{{t 'approvalsEmployee.lblTask'}}</strong> {{this.taskName}}</div>{{/if}}
                    {{#if this.requestedFromDate}}<div><strong>{{t 'approvalsEmployee.lblLeave'}}</strong> {{this.requestedFromDateText}} - {{this.requestedToDateText}}</div>{{/if}}
                    {{#if this.requestedDate}}<div><strong>{{t 'approvalsEmployee.lblShift'}}</strong> {{this.requestedDateText}} ({{this.currentTimeStart}}-{{this.currentTimeEnd}} -> {{this.requestedTimeStart}}-{{this.requestedTimeEnd}})</div>{{/if}}
                    {{#if this.requestedDeadline}}<div><strong>{{t 'approvalsEmployee.lblNewDeadline'}}</strong> {{this.requestedDeadlineText}}</div>{{/if}}
                  </td>
                  <td><span class="badge {{this.statusClass}}">{{this.statusLabel}}</span></td>
                  <td>
                    <div>{{this.managerNote}}</div>
                    {{#if this.reviewedAt}}<small class="small-muted">{{this.reviewedAtText}} - {{this.reviewedByName}}</small>{{/if}}
                  </td>
                </tr>
              {{/each}}
            {{else}}
              <tr>
                <td colspan="5" class="text-center text-muted py-4">{{t 'approvalsEmployee.noRequests'}}</td>
              </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  const requestType = document.getElementById('requestType');
  const leaveFields = document.getElementById('leaveFields');
  const shiftFields = document.getElementById('shiftFields');
  const deadlineFields = document.getElementById('deadlineFields');

  function toggleTypeFields() {
    const v = requestType.value;
    leaveFields.classList.toggle('d-none', v !== 'leave');
    shiftFields.classList.toggle('d-none', v !== 'shift_change');
    deadlineFields.classList.toggle('d-none', v !== 'deadline_extension');
  }

  requestType.addEventListener('change', toggleTypeFields);
  toggleTypeFields();
</script>
</div>
