<div class="approvals-employee-view">
<div class="container py-4 approval-wrap">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
      <h3 class="mb-1">My Requests</h3>
      <div class="small-muted">Send requests to manager: leave, shift change, deadline extension.</div>
    </div>
    <a href="/dashboard" class="btn btn-outline-secondary btn-sm">Back Dashboard</a>
  </div>

  <div class="card card-soft mb-4">
    <div class="card-body">
      <h5 class="mb-3">Create Request</h5>
      <form method="POST" action="/approvals/request" id="approvalForm">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Request Type</label>
            <select class="form-select" name="requestType" id="requestType" required>
              <option value="leave">Leave request</option>
              <option value="shift_change">Shift change</option>
              <option value="deadline_extension">Deadline extension</option>
            </select>
          </div>
          <div class="col-md-8">
            <label class="form-label">Reason</label>
            <input class="form-control" name="reason" minlength="6" required placeholder="Nhap ly do...">
          </div>
        </div>

        <div id="leaveFields" class="row g-3 mt-1">
          <div class="col-md-6">
            <label class="form-label">From Date</label>
            <input type="date" class="form-control" name="requestedFromDate" value="{{todayDate}}">
          </div>
          <div class="col-md-6">
            <label class="form-label">To Date</label>
            <input type="date" class="form-control" name="requestedToDate" value="{{todayDate}}">
          </div>
        </div>

        <div id="shiftFields" class="row g-3 mt-1 d-none">
          <div class="col-md-3">
            <label class="form-label">Date</label>
            <input type="date" class="form-control" name="requestedDate" value="{{todayDate}}">
          </div>
          <div class="col-md-3">
            <label class="form-label">Current Start</label>
            <input type="time" class="form-control" name="currentTimeStart">
          </div>
          <div class="col-md-3">
            <label class="form-label">Current End</label>
            <input type="time" class="form-control" name="currentTimeEnd">
          </div>
          <div class="col-md-3">
            <label class="form-label">Requested Start</label>
            <input type="time" class="form-control" name="requestedTimeStart">
          </div>
          <div class="col-md-3">
            <label class="form-label">Requested End</label>
            <input type="time" class="form-control" name="requestedTimeEnd">
          </div>
        </div>

        <div id="deadlineFields" class="row g-3 mt-1 d-none">
          <div class="col-md-6">
            <label class="form-label">Task</label>
            <select class="form-select" name="taskID">
              <option value="">-- Chon task --</option>
              {{#each assignedTasks}}
                <option value="{{this._id}}">{{this.name_task}} (deadline: {{this.deadlineText}})</option>
              {{/each}}
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label">Requested Deadline</label>
            <input type="date" class="form-control" name="requestedDeadline" value="{{todayDate}}">
          </div>
        </div>

        <div class="mt-3">
          <button class="btn btn-primary" type="submit">Send Request</button>
        </div>
      </form>
    </div>
  </div>

  <div class="card card-soft">
    <div class="card-body">
      <h5 class="mb-3">Request History</h5>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>Created</th>
              <th>Type</th>
              <th>Detail</th>
              <th>Status</th>
              <th>Manager Note</th>
            </tr>
          </thead>
          <tbody>
            {{#if requestRows.length}}
              {{#each requestRows}}
                <tr>
                  <td>{{this.createdAtText}}</td>
                  <td>{{this.requestTypeLabel}}</td>
                  <td>
                    <div><strong>Reason:</strong> {{this.reason}}</div>
                    {{#if this.taskName}}<div><strong>Task:</strong> {{this.taskName}}</div>{{/if}}
                    {{#if this.requestedFromDate}}<div><strong>Leave:</strong> {{this.requestedFromDateText}} - {{this.requestedToDateText}}</div>{{/if}}
                    {{#if this.requestedDate}}<div><strong>Shift change:</strong> {{this.requestedDateText}} ({{this.currentTimeStart}}-{{this.currentTimeEnd}} -> {{this.requestedTimeStart}}-{{this.requestedTimeEnd}})</div>{{/if}}
                    {{#if this.requestedDeadline}}<div><strong>New deadline:</strong> {{this.requestedDeadlineText}}</div>{{/if}}
                  </td>
                  <td><span class="badge {{this.statusClass}}">{{this.statusLabel}}</span></td>
                  <td>
                    <div>{{this.managerNote}}</div>
                    {{#if this.reviewedAt}}<small class="small-muted">{{this.reviewedAtText}} - {{this.reviewedByName}}</small>{{/if}}
                  </td>
                </tr>
              {{/each}}
            {{else}}
              <tr>
                <td colspan="5" class="text-center text-muted py-4">No requests yet.</td>
              </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  const requestType = document.getElementById('requestType');
  const leaveFields = document.getElementById('leaveFields');
  const shiftFields = document.getElementById('shiftFields');
  const deadlineFields = document.getElementById('deadlineFields');

  function toggleTypeFields() {
    const v = requestType.value;
    leaveFields.classList.toggle('d-none', v !== 'leave');
    shiftFields.classList.toggle('d-none', v !== 'shift_change');
    deadlineFields.classList.toggle('d-none', v !== 'deadline_extension');
  }

  requestType.addEventListener('change', toggleTypeFields);
  toggleTypeFields();
</script>
</div>
