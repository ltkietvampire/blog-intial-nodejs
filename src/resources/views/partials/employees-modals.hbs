<!-- ADD PEOPLE MODAL -->
<div class="modal fade" id="addPeopleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add New Employee</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="addPeopleForm" method="POST" action="/employee/store">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Name</label>
            <input type="text" class="form-control" name="name" placeholder="Enter full name" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" name="email" placeholder="name@company.com" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Phone (SDT)</label>
            <input type="text" class="form-control" name="SDT" placeholder="Enter phone number" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" class="form-control" name="password" placeholder="At least 6 characters" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Role</label>
            <select class="form-select" name="role" required>
              <option value="employee" selected>Employee</option>
              <option value="manager">Manager</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Position</label>
            <input type="text" class="form-control" name="position" placeholder="Example: Staff, Supervisor" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Hourly rate</label>
            <input type="number" class="form-control" name="hourlyRate" min="0" step="0.01" value="0">
          </div>
          <div class="mb-3">
            <label class="form-label">Max working hours/day</label>
            <input type="number" class="form-control" name="maxtime" min="0" max="8" value="8" required>
          </div>
          <div class="mb-1">
            <label class="form-label">Status</label>
            <select class="form-select" name="trangthai" required>
              <option value="status-active" selected>Active</option>
              <option value="status-busy">Busy</option>
              <option value="status-off">Off</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- VIEW EMPLOYEE MODAL -->
<div class="modal fade" id="viewEmployeeModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Employee Profile</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="profileCover" class="profile-cover">
          <img id="profileAvatar" class="profile-avatar" src="/img/default-avatar.webp" alt="avatar">
        </div>

        <div class="profile-meta">
          <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
              <div id="profileName" class="profile-title">--</div>
              <div class="text-muted" id="profileEmail">--</div>
            </div>
            <span id="profileStatus" class="status-pill status-active">Active</span>
          </div>

          <div class="info-grid mt-3">
            <div class="info-item">
              <div class="label">User ID</div>
              <div class="value" id="profileId">--</div>
            </div>
            <div class="info-item">
              <div class="label">Phone</div>
              <div class="value" id="profilePhone">--</div>
            </div>
            <div class="info-item">
              <div class="label">Role</div>
              <div class="value" id="profileRole">--</div>
            </div>
            <div class="info-item">
              <div class="label">Position</div>
              <div class="value" id="profilePosition">--</div>
            </div>
            <div class="info-item">
              <div class="label">Hourly Rate</div>
              <div class="value" id="profileHourlyRate">--</div>
            </div>
            <div class="info-item">
              <div class="label">Max Hours/Day</div>
              <div class="value" id="profileMaxTime">--</div>
            </div>
            <div class="info-item">
              <div class="label">Total Working Hours</div>
              <div class="value" id="profileTotalHours">--</div>
            </div>
            <div class="info-item">
              <div class="label">State</div>
              <div class="value" id="profileState">--</div>
            </div>
            <div class="info-item">
              <div class="label">Created At</div>
              <div class="value" id="profileCreatedAt">--</div>
            </div>
            <div class="info-item">
              <div class="label">Updated At</div>
              <div class="value" id="profileUpdatedAt">--</div>
            </div>
          </div>

          <div class="info-item mt-3">
            <div class="label">Introduction</div>
            <div class="value" id="profileIntroduce">--</div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- EDIT EMPLOYEE MODAL -->
<div class="modal fade" id="editEmployeeModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <form method="POST" id="editEmployeeForm" class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Edit Employee</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">Name</label>
          <input type="text" class="form-control" name="name" id="editName" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Email</label>
          <input type="email" class="form-control" name="email" id="editEmail" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Phone (SDT)</label>
          <input type="text" class="form-control" name="SDT" id="editSDT" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Role</label>
          <select class="form-select" name="role" id="editRole" required>
            <option value="employee">Employee</option>
            <option value="manager">Manager</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="form-label">Position</label>
          <input type="text" class="form-control" name="position" id="editPosition" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Hourly rate</label>
          <input type="number" class="form-control" name="hourlyRate" id="editHourlyRate" min="0" step="0.01">
        </div>
        <div class="mb-3">
          <label class="form-label">Max working hours/day</label>
          <input type="number" class="form-control" name="maxtime" id="editMaxTime" min="0" max="8" step="1" required>
        </div>
        <div class="mb-1">
          <label class="form-label">Status</label>
          <select class="form-select" name="trangthai" id="editTrangThai" required>
            <option value="status-active">Active</option>
            <option value="status-busy">Busy</option>
            <option value="status-off">Off</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save changes</button>
      </div>
    </form>
  </div>
</div>

<!-- DELETE EMPLOYEE MODAL -->
<div class="modal fade" tabindex="-1" id="deleteEmployeeModal" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Delete Employee</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="mb-0">Are you sure you want to delete this account?</p>
      </div>
      <div class="modal-footer">
        <button id="btn-delete-confirm" type="button" class="btn btn-danger">Delete</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
      </div>
    </div>
  </div>
</div>
