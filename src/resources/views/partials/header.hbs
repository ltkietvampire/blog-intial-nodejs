<nav class="navbar navbar-expand-lg bg-transparent app-header">
  <div class="container-fluid">

    <!-- Logo -->
    <a class="navbar-brand fw-bold fs-3" href="/">
      kit
    </a>

    <!-- Toggle (mobile) -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Menu -->
    <div class="collapse navbar-collapse" id="mainNavbar">

      <!-- Center menu -->
      <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-3">
        {{#if currentUser}}
          {{#if isManager}}
            <li class="nav-item">
              <a class="nav-link" href="/">Schedule</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/tasks">Tasks</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/employee">Employees</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/salary">Payroll</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/employee/statistics">Employee Statistics</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/approvals">Approval Center</a>
            </li>
          {{else}}
            <li class="nav-item">
              <a class="nav-link" href="/dashboard">Dashboard</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/my-task">My Tasks</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/my-task/schedule">My Schedule</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/auth">My Profile</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/approvals/my">My Requests</a>
            </li>
          {{/if}}
        {{/if}}
      </ul>

      <!-- Right buttons -->
<div class="d-flex align-items-center gap-3">

  {{#if currentUser}}
    <!-- Logged in -->
    <div class="dropdown">
      <button
        class="notification-btn position-relative text-dark"
        type="button"
        data-bs-toggle="dropdown"
        aria-expanded="false"
      >
        {{#if isManager}}
          <i class="bi bi-bell-fill fs-5 {{#if approvalNotifications.totalCount}}bell-alert{{/if}}"></i>
          {{#if approvalNotifications.totalCount}}
            <span class="badge bg-danger position-absolute notification-badge">
              {{approvalNotifications.totalCount}}
            </span>
          {{/if}}
        {{else}}
          <i class="bi bi-bell-fill fs-5 {{#if taskNotifications.urgentCount}}bell-alert{{/if}}"></i>
          {{#if taskNotifications.totalCount}}
            <span class="badge bg-danger position-absolute notification-badge">
              {{taskNotifications.totalCount}}
            </span>
          {{/if}}
        {{/if}}
      </button>

      <ul class="dropdown-menu dropdown-menu-end shadow notification-menu p-0">
        {{#if isManager}}
          <li class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center">
            <strong>Pending Approvals</strong>
            <span class="badge bg-light text-dark">{{approvalNotifications.totalCount}}</span>
          </li>

          {{#if approvalNotifications.items.length}}
            {{#each approvalNotifications.items}}
              <li>
                <a class="dropdown-item notification-item py-2 px-3" href="{{this.link}}">
                  <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                      <div class="fw-semibold">{{this.title}}</div>
                      {{#if this.taskName}}
                        <div class="small text-muted">{{this.taskName}}</div>
                      {{/if}}
                      <div class="small text-secondary">{{this.detail}}</div>
                    </div>
                    <span class="badge {{this.tagClass}} text-uppercase">{{this.type}}</span>
                  </div>
                </a>
              </li>
            {{/each}}
          {{else}}
            <li class="px-3 py-3 text-muted small">No pending approvals.</li>
          {{/if}}

          <li class="border-top">
            <a class="dropdown-item text-center py-2" href="/approvals">Open Approval Center</a>
          </li>
        {{else}}
          <li class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center">
            <strong>Task Notifications</strong>
            <span class="badge bg-light text-dark">{{taskNotifications.totalCount}}</span>
          </li>

          {{#if taskNotifications.items.length}}
            {{#each taskNotifications.items}}
              <li>
                <a class="dropdown-item notification-item py-2 px-3" href="{{this.link}}">
                  <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                      <div class="fw-semibold">{{this.title}}</div>
                      <div class="small text-muted">{{this.taskName}}</div>
                      <div class="small text-secondary">{{this.detail}}</div>
                    </div>
                    <span class="badge {{this.tagClass}} text-uppercase">{{this.type}}</span>
                  </div>
                </a>
              </li>
            {{/each}}
          {{else}}
            <li class="px-3 py-3 text-muted small">No notifications at the moment.</li>
          {{/if}}

          <li class="border-top">
            <a class="dropdown-item text-center py-2" href="{{#if isEmployee}}/my-task{{else}}/tasks{{/if}}">View all tasks</a>
          </li>
        {{/if}}
      </ul>
    </div>

    <div class="dropdown">
      <a class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle"
         href="#"
         data-bs-toggle="dropdown">

        <img
          src="{{#if currentUser.avatar}}{{assetPath currentUser.avatar}}{{else}}/img/default-avatar.webp{{/if}}"
          class="rounded-circle"
          width="36"
          height="36"
        />

        <span class="fw-semibold text-dark">
          {{currentUser.name}}
        </span>
      </a>

      <ul class="dropdown-menu dropdown-menu-end shadow">
        {{#if isEmployee}}
          <li><a class="dropdown-item" href="/dashboard">Dashboard</a></li>
        {{/if}}
        <li><a class="dropdown-item" href="/auth">Profile</a></li>
        <li><a class="dropdown-item" href="/my-task">My Tasks</a></li>
        {{#if isEmployee}}
          <li><a class="dropdown-item" href="/my-task/schedule">My Schedule</a></li>
          <li><a class="dropdown-item" href="/approvals/my">My Requests</a></li>
        {{/if}}
        {{#if isManager}}
          <li><a class="dropdown-item" href="/employee">Employees</a></li>
          <li><a class="dropdown-item" href="/salary">Payroll</a></li>
          <li><a class="dropdown-item" href="/tasks">Tasks</a></li>
          <li><a class="dropdown-item" href="/approvals">Approval Center</a></li>
        {{/if}}
        <li><hr class="dropdown-divider"></li>
        <li><a class="dropdown-item text-danger" href="/logout">Logout</a></li>
      </ul>
    </div>

  {{else}}
    <!-- Guest -->
    <a href="/login" class="text-decoration-none fw-semibold text-dark">
      Log in
    </a>
    <a href="#" class="btn btn-primary">
      Start free trial
    </a>
  {{/if}}

</div>

    </div>
  </div>
</nav>
