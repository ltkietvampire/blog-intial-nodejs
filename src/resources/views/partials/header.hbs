{{#if currentUser}}
<script>
  document.addEventListener('click', (event) => {
    const link = event.target.closest('[data-announcement-id]');
    if (!link) return;
    if (link.dataset.announcementSeen === 'true') return;
    const announcementId = link.dataset.announcementId;
    if (!announcementId) return;
    event.preventDefault();

    if (navigator.sendBeacon) {
      navigator.sendBeacon(`/announcements/${announcementId}/seen`);
    } else {
      fetch(`/announcements/${announcementId}/seen`, { method: 'POST', keepalive: true });
    }

    link.dataset.announcementSeen = 'true';
    const badge = link.querySelector('.badge');
    if (badge) {
      badge.classList.remove('bg-warning', 'text-dark');
      badge.classList.add('bg-light', 'text-dark');
      badge.textContent = 'seen';
    }
  });
</script>
{{/if}}

