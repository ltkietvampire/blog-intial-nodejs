<div class="employees-view">
  <div class="employees-shell">
    <section class="hero-card">
      <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div>
          <div class="hero-title">{{t 'employees.title'}}</div>
          <div class="hero-subtitle">{{t 'employees.subtitle'}}</div>
        </div>
        <div class="d-flex flex-wrap hero-actions">
          <a href="/employee/statistics" class="btn btn-soft-light">
            <i class="bi bi-graph-up-arrow me-1"></i>
            {{t 'employees.btnStats'}}
          </a>
          <button type="button" class="btn btn-brand" data-bs-toggle="modal" data-bs-target="#addPeopleModal">
            <i class="bi bi-person-plus-fill me-1"></i>
            {{t 'employees.btnAdd'}}
          </button>
        </div>
      </div>
    </section>

    <section class="summary-grid">
      <article class="summary-card">
        <div class="summary-label">{{t 'employees.summaryTotal'}}</div>
        <div class="summary-value" id="summaryTotal">0</div>
        <div class="summary-hint">{{t 'employees.summaryTotalHint'}}</div>
      </article>
      <article class="summary-card">
        <div class="summary-label">{{t 'employees.summaryActive'}}</div>
        <div class="summary-value text-success" id="summaryActive">0</div>
        <div class="summary-hint">{{t 'employees.summaryActiveHint'}}</div>
      </article>
      <article class="summary-card">
        <div class="summary-label">{{t 'employees.summaryBusy'}}</div>
        <div class="summary-value" style="color: #c2410c;" id="summaryBusy">0</div>
        <div class="summary-hint">{{t 'employees.summaryBusyHint'}}</div>
      </article>
      <article class="summary-card">
        <div class="summary-label">{{t 'employees.summaryOff'}}</div>
        <div class="summary-value text-danger" id="summaryOff">0</div>
        <div class="summary-hint">{{t 'employees.summaryOffHint'}}</div>
      </article>
    </section>

    <section class="workbench">
      <div class="toolbar">
        <div class="row g-2 align-items-center">
          <div class="col-lg-4 col-md-6">
            <input id="searchInput" type="text" class="form-control" placeholder="{{t 'employees.searchPlaceholder'}}">
          </div>
          <div class="col-lg-3 col-md-6">
            <select id="statusFilter" class="form-select">
              <option value="all">{{t 'employees.filterAllStatus'}}</option>
              <option value="status-active">{{t 'employees.summaryActive'}}</option>
              <option value="status-busy">{{t 'employees.summaryBusy'}}</option>
              <option value="status-off">{{t 'employees.summaryOff'}}</option>
            </select>
          </div>
          <div class="col-lg-3 col-md-6">
            <select id="positionFilter" class="form-select">
              <option value="all">{{t 'employees.filterAllPosition'}}</option>
            </select>
          </div>
          <div class="col-lg-2 col-md-6 d-grid">
            <button id="clearFilters" type="button" class="btn btn-outline-secondary">{{t 'employees.clearFilters'}}</button>
          </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3 gap-2 flex-wrap">
          <div class="toolbar-meta" id="showingText">Showing 0 of 0 members</div>
          <div class="small text-muted">{{t 'employees.tipRowAction'}}</div>
        </div>
        <div id="bulkActionsBar" class="d-none flex-wrap align-items-center gap-2 mt-3">
          <span class="badge text-bg-light border" id="selectedCountText">0 selected</span>
          <select id="bulkStatusSelect" class="form-select" style="max-width: 200px;">
            <option value="">{{t 'employees.changeStatus'}}</option>
            <option value="status-active">{{t 'employees.summaryActive'}}</option>
            <option value="status-busy">{{t 'employees.summaryBusy'}}</option>
            <option value="status-off">{{t 'employees.summaryOff'}}</option>
          </select>
          <button id="btnApplyBulkStatus" type="button" class="btn btn-outline-primary" disabled>
            {{t 'employees.btnApplyBulk'}}
          </button>
          <button id="btnBulkDelete" type="button" class="btn btn-outline-danger" disabled>
            {{t 'employees.btnBulkDelete'}}
          </button>
        </div>
      </div>

      <div class="table-wrap">
        <div class="table-responsive">
          <table class="table align-middle">
            <thead>
              <tr>
                <th style="width: 40px;"><input id="selectAllEmployees" type="checkbox" aria-label="select all"></th>
                <th>{{t 'employees.colMember'}}</th>
                <th>{{t 'employees.colPhone'}}</th>
                <th>{{t 'employees.colRole'}}</th>
                <th>{{t 'employees.colCapacity'}}</th>
                <th>{{t 'employees.colRate'}}</th>
                <th>{{t 'employees.colStatus'}}</th>
                <th class="text-end">{{t 'employees.colActions'}}</th>
              </tr>
            </thead>
            <tbody id="employeeTableBody">
              {{#each userss}}
                <tr
                  class="employee-row"
                  data-name="{{this.name}}"
                  data-email="{{this.email}}"
                  data-phone="{{this.SDT}}"
                  data-position="{{this.position}}"
                  data-role="{{#if this.role}}{{this.role}}{{else}}employee{{/if}}"
                  data-status="{{this.trangthai}}"
                  data-hourlyrate="{{this.hourlyRate}}"
                  data-id="{{this._id}}"
                >
                  <td><input class="row-checkbox" type="checkbox" aria-label="select row" data-id="{{this._id}}"></td>
                  <td>
                    <div class="d-flex align-items-center gap-3">
                      <img
                        class="avatar-img"
                        src="{{#if this.avatar}}{{assetPath this.avatar}}{{else}}/img/default-avatar.webp{{/if}}"
                        alt="{{this.name}}"
                        onerror="this.src='/img/default-avatar.webp'"
                      >
                      <div>
                        <div class="member-name">{{this.name}}</div>
                        <div class="member-sub">{{this.email}}</div>
                      </div>
                    </div>
                  </td>
                  <td>{{this.SDT}}</td>
                  <td>
                    <div><span class="role-chip">{{#if this.role}}{{this.role}}{{else}}employee{{/if}}</span></div>
                    <div class="member-sub mt-1">{{this.position}}</div>
                  </td>
                  <td><span class="capacity-badge">{{this.maxtime}}h/day</span></td>
                  <td><span class="capacity-badge">{{this.hourlyRate}}</span></td>
                  <td>
                    <span class="status-pill {{this.trangthai}}" data-status="{{this.trangthai}}">
                      {{this.trangthai}}
                    </span>
                    {{#if this.isBanned}}
                      <span class="badge bg-danger ms-1">{{t 'employees.banned'}}</span>
                    {{/if}}
                  </td>
                  <td class="text-end">
                    <div class="dropdown">
                      <button class="btn btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-three-dots-vertical"></i>
                      </button>
                      <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li>
                          <button
                            type="button"
                            class="dropdown-item btn-view-profile"
                            data-id="{{this._id}}"
                            data-name="{{this.name}}"
                            data-email="{{this.email}}"
                            data-sdt="{{this.SDT}}"
                            data-role="{{#if this.role}}{{this.role}}{{else}}employee{{/if}}"
                            data-position="{{this.position}}"
                            data-maxtime="{{this.maxtime}}"
                            data-hourlyrate="{{this.hourlyRate}}"
                            data-trangthai="{{this.trangthai}}"
                            data-avatar="{{#if this.avatar}}{{assetPath this.avatar}}{{else}}/img/default-avatar.webp{{/if}}"
                            data-cover="{{#if this.cover}}{{assetPath this.cover}}{{else}}/img/default-avatar.webp{{/if}}"
                            data-state="{{this.state}}"
                            data-introduce="{{this.introduce}}"
                            data-totalworkinghours="{{this.totalWorkingHours}}"
                            data-createdat="{{this.createdAt}}"
                            data-updatedat="{{this.updatedAt}}"
                          >
                            {{t 'employees.actionView'}}
                          </button>
                        </li>
                        <li>
                          <button
                            class="dropdown-item btn-edit"
                            data-id="{{this._id}}"
                            data-name="{{this.name}}"
                            data-email="{{this.email}}"
                            data-sdt="{{this.sdt}}"
                            data-role="{{#if this.role}}{{this.role}}{{else}}employee{{/if}}"
                            data-position="{{this.position}}"
                            data-maxtime="{{this.maxtime}}"
                            data-hourlyrate="{{this.hourlyRate}}"
                            data-trangthai="{{this.trangthai}}"
                          >
                            {{t 'employees.actionEdit'}}
                          </button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                          <button
                            class="dropdown-item text-danger btn-delete"
                            data-id="{{this._id}}"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteEmployeeModal"
                          >
                            {{t 'employees.actionDelete'}}
                          </button>
                        </li>
                        {{#if ../isAdmin}}
                        <li><hr class="dropdown-divider"></li>
                        <li>
                          <form action="/admin/toggle-ban" method="POST" class="m-0 p-0">
                            <input type="hidden" name="userId" value="{{this._id}}">
                            <button type="submit" class="dropdown-item text-warning fw-bold">
                              {{#if this.isBanned}}{{t 'employees.actionUnban'}}{{else}}{{t 'employees.actionBan'}}{{/if}}
                            </button>
                          </form>
                        </li>
                        {{/if}}
                      </ul>
                    </div>
                  </td>
                </tr>
              {{else}}
                <tr>
                  <td colspan="8" class="empty-cell">
                    {{t 'employees.noEmployees'}}
                  </td>
                </tr>
              {{/each}}
              <tr id="emptyFilterRow" style="display: none;">
                <td colspan="8" class="empty-cell">
                  No results match your filters.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>

  <form method="POST" id="formDelete"></form>
  <form method="POST" id="formBulkDelete" action="/employee/bulk-delete"></form>
  <form method="POST" id="formBulkStatus" action="/employee/bulk-status">
    <input type="hidden" name="trangthai" id="bulkStatusHidden" value="">
  </form>

  {{> employees-modals}}

  <script src="/js/employees.js"></script>
</div>
