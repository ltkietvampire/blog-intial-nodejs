<div class="employees-view">
<div class="employees-shell">
  <section class="hero-card">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
      <div>
        <div class="hero-title">People Operations</div>
        <div class="hero-subtitle">Manage team members, workloads, and availability in one place.</div>
      </div>
      <div class="d-flex flex-wrap hero-actions">
        <a href="/employee/statistics" class="btn btn-soft-light">
          <i class="bi bi-graph-up-arrow me-1"></i>
          Employee Statistics
        </a>
        <button type="button" class="btn btn-brand" data-bs-toggle="modal" data-bs-target="#addPeopleModal">
          <i class="bi bi-person-plus-fill me-1"></i>
          Add Employee
        </button>
      </div>
    </div>
  </section>

  <section class="summary-grid">
    <article class="summary-card">
      <div class="summary-label">Total Members</div>
      <div class="summary-value" id="summaryTotal">0</div>
      <div class="summary-hint">All accounts in this workspace</div>
    </article>
    <article class="summary-card">
      <div class="summary-label">Active</div>
      <div class="summary-value text-success" id="summaryActive">0</div>
      <div class="summary-hint">Ready for assignments</div>
    </article>
    <article class="summary-card">
      <div class="summary-label">Busy</div>
      <div class="summary-value" style="color: #c2410c;" id="summaryBusy">0</div>
      <div class="summary-hint">Currently handling heavy load</div>
    </article>
    <article class="summary-card">
      <div class="summary-label">Off</div>
      <div class="summary-value text-danger" id="summaryOff">0</div>
      <div class="summary-hint">Unavailable now</div>
    </article>
  </section>

  <section class="workbench">
    <div class="toolbar">
      <div class="row g-2 align-items-center">
        <div class="col-lg-4 col-md-6">
          <input id="searchInput" type="text" class="form-control" placeholder="Search by name, email, phone">
        </div>
        <div class="col-lg-3 col-md-6">
          <select id="statusFilter" class="form-select">
            <option value="all">All statuses</option>
            <option value="status-active">Active</option>
            <option value="status-busy">Busy</option>
            <option value="status-off">Off</option>
          </select>
        </div>
        <div class="col-lg-3 col-md-6">
          <select id="positionFilter" class="form-select">
            <option value="all">All positions</option>
          </select>
        </div>
        <div class="col-lg-2 col-md-6 d-grid">
          <button id="clearFilters" type="button" class="btn btn-outline-secondary">Clear filters</button>
        </div>
      </div>
      <div class="d-flex justify-content-between align-items-center mt-3 gap-2 flex-wrap">
        <div class="toolbar-meta" id="showingText">Showing 0 of 0 members</div>
        <div class="small text-muted">Tip: click the 3-dot action menu on each row to edit or delete quickly.</div>
      </div>
      <div id="bulkActionsBar" class="d-none flex-wrap align-items-center gap-2 mt-3">
        <span class="badge text-bg-light border" id="selectedCountText">0 selected</span>
        <select id="bulkStatusSelect" class="form-select" style="max-width: 200px;">
          <option value="">Change status...</option>
          <option value="status-active">Active</option>
          <option value="status-busy">Busy</option>
          <option value="status-off">Off</option>
        </select>
        <button id="btnApplyBulkStatus" type="button" class="btn btn-outline-primary" disabled>
          Apply status
        </button>
        <button id="btnBulkDelete" type="button" class="btn btn-outline-danger" disabled>
          Delete selected
        </button>
      </div>
    </div>

    <div class="table-wrap">
      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr>
              <th style="width: 40px;"><input id="selectAllEmployees" type="checkbox" aria-label="select all"></th>
              <th>Member</th>
              <th>Phone</th>
              <th>Role</th>
              <th>Capacity</th>
              <th>Hourly Rate</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody id="employeeTableBody">
            {{#each userss}}
              <tr
                class="employee-row"
                data-name="{{this.name}}"
                data-email="{{this.email}}"
                data-phone="{{this.SDT}}"
                data-position="{{this.position}}"
                data-role="{{#if this.role}}{{this.role}}{{else}}employee{{/if}}"
                data-status="{{this.trangthai}}"
                data-hourlyrate="{{this.hourlyRate}}"
                data-id="{{this._id}}"
              >
                <td><input class="row-checkbox" type="checkbox" aria-label="select row" data-id="{{this._id}}"></td>
                <td>
                  <div class="d-flex align-items-center gap-3">
                    <img
                      class="avatar-img"
                      src="{{#if this.avatar}}{{assetPath this.avatar}}{{else}}/img/default-avatar.webp{{/if}}"
                      alt="{{this.name}}"
                      onerror="this.src='/img/default-avatar.webp'"
                    >
                    <div>
                      <div class="member-name">{{this.name}}</div>
                      <div class="member-sub">{{this.email}}</div>
                    </div>
                  </div>
                </td>
                <td>{{this.SDT}}</td>
                <td>
                  <div><span class="role-chip">{{#if this.role}}{{this.role}}{{else}}employee{{/if}}</span></div>
                  <div class="member-sub mt-1">{{this.position}}</div>
                </td>
                <td><span class="capacity-badge">{{this.maxtime}}h/day</span></td>
                <td><span class="capacity-badge">{{this.hourlyRate}}</span></td>
                <td>
                  <span class="status-pill {{this.trangthai}}" data-status="{{this.trangthai}}">
                    {{this.trangthai}}
                  </span>
                </td>
                <td class="text-end">
                  <div class="dropdown">
                    <button class="btn btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                      <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                      <li>
                        <button
                          type="button"
                          class="dropdown-item btn-view-profile"
                          data-id="{{this._id}}"
                          data-name="{{this.name}}"
                          data-email="{{this.email}}"
                          data-sdt="{{this.SDT}}"
                          data-role="{{#if this.role}}{{this.role}}{{else}}employee{{/if}}"
                          data-position="{{this.position}}"
                          data-maxtime="{{this.maxtime}}"
                          data-hourlyrate="{{this.hourlyRate}}"
                          data-trangthai="{{this.trangthai}}"
                          data-avatar="{{#if this.avatar}}{{assetPath this.avatar}}{{else}}/img/default-avatar.webp{{/if}}"
                          data-cover="{{#if this.cover}}{{assetPath this.cover}}{{else}}/img/default-avatar.webp{{/if}}"
                          data-state="{{this.state}}"
                          data-introduce="{{this.introduce}}"
                          data-totalworkinghours="{{this.totalWorkingHours}}"
                          data-createdat="{{this.createdAt}}"
                          data-updatedat="{{this.updatedAt}}"
                        >
                          View profile
                        </button>
                      </li>
                      <li>
                        <button
                          class="dropdown-item btn-edit"
                          data-id="{{this._id}}"
                          data-name="{{this.name}}"
                          data-email="{{this.email}}"
                          data-sdt="{{this.SDT}}"
                          data-role="{{#if this.role}}{{this.role}}{{else}}employee{{/if}}"
                          data-position="{{this.position}}"
                          data-maxtime="{{this.maxtime}}"
                          data-hourlyrate="{{this.hourlyRate}}"
                          data-trangthai="{{this.trangthai}}"
                        >
                          Edit employee
                        </button>
                      </li>
                      <li><hr class="dropdown-divider"></li>
                      <li>
                        <button
                          class="dropdown-item text-danger btn-delete"
                          data-id="{{this._id}}"
                          data-bs-toggle="modal"
                          data-bs-target="#deleteEmployeeModal"
                        >
                          Delete employee
                        </button>
                      </li>
                    </ul>
                  </div>
                </td>
              </tr>
            {{else}}
              <tr>
                <td colspan="8" class="empty-cell">
                  No employees found. Start by adding a new employee.
                </td>
              </tr>
            {{/each}}
            <tr id="emptyFilterRow" style="display: none;">
              <td colspan="8" class="empty-cell">
                No results match your filters.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>

<form method="POST" id="formDelete"></form>
<form method="POST" id="formBulkDelete" action="/employee/bulk-delete"></form>
<form method="POST" id="formBulkStatus" action="/employee/bulk-status">
  <input type="hidden" name="trangthai" id="bulkStatusHidden" value="">
</form>

<div class="modal fade" id="addPeopleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add New Employee</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="addPeopleForm" method="POST" action="/employee/store">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Name</label>
            <input type="text" class="form-control" name="name" placeholder="Enter full name" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" name="email" placeholder="name@company.com" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Phone (SDT)</label>
            <input type="text" class="form-control" name="SDT" placeholder="Enter phone number" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" class="form-control" name="password" placeholder="At least 6 characters" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Role</label>
            <select class="form-select" name="role" required>
              <option value="employee" selected>Employee</option>
              <option value="manager">Manager</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Position</label>
            <input type="text" class="form-control" name="position" placeholder="Example: Staff, Supervisor" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Hourly rate</label>
            <input type="number" class="form-control" name="hourlyRate" min="0" step="0.01" value="0">
          </div>
          <div class="mb-3">
            <label class="form-label">Max working hours/day</label>
            <input type="number" class="form-control" name="maxtime" min="0" max="8" value="8" required>
          </div>
          <div class="mb-1">
            <label class="form-label">Status</label>
            <select class="form-select" name="trangthai" required>
              <option value="status-active" selected>Active</option>
              <option value="status-busy">Busy</option>
              <option value="status-off">Off</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="viewEmployeeModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Employee Profile</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
