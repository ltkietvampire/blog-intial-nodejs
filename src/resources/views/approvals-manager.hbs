<div class="approvals-manager-view">
<div class="container py-4 approval-manager-wrap">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
      <h3 class="mb-1">{{t 'approvalsManager.title'}}</h3>
      <div class="small-muted">{{t 'approvalsManager.subtitle'}}</div>
    </div>
    <span class="badge text-bg-warning">{{t 'approvalsManager.pendingCount'}} {{pendingRequests.length}}</span>
  </div>

  <div class="card card-soft mb-4">
    <div class="card-body">
      <h5 class="mb-3">{{t 'approvalsManager.pendingTitle'}}</h5>
      {{#if pendingRequests.length}}
        <div class="d-grid gap-3">
          {{#each pendingRequests}}
            <div class="border rounded p-3">
              <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                <div>
                  <div class="fw-semibold">{{this.requesterName}} - {{this.requestTypeLabel}}</div>
                  <div class="small-muted">{{t 'approvalsManager.lblCreated'}} {{this.createdAtText}} | {{t 'approvalsManager.lblEmail'}} {{this.requesterEmail}}</div>
                </div>
                <span class="badge {{this.statusClass}}">{{this.statusLabel}}</span>
              </div>

              <div class="mb-2"><strong>{{t 'approvalsEmployee.lblReason'}}</strong> {{this.reason}}</div>
              {{#if this.taskName}}<div class="mb-1"><strong>{{t 'approvalsEmployee.lblTask'}}</strong> {{this.taskName}} (deadline: {{this.taskDeadlineText}})</div>{{/if}}
              {{#if this.requestedFromDate}}<div class="mb-1"><strong>{{t 'approvalsEmployee.lblLeave'}}</strong> {{this.requestedFromDateText}} - {{this.requestedToDateText}}</div>{{/if}}
              {{#if this.requestedDate}}<div class="mb-1"><strong>{{t 'approvalsEmployee.lblShift'}}</strong> {{this.requestedDateText}} ({{this.currentTimeStart}}-{{this.currentTimeEnd}} -> {{this.requestedTimeStart}}-{{this.requestedTimeEnd}})</div>{{/if}}
              {{#if this.requestedDeadline}}<div class="mb-1"><strong>{{t 'approvalsEmployee.lblNewDeadline'}}</strong> {{this.requestedDeadlineText}}</div>{{/if}}

              <div class="row g-2 mt-1">
                <div class="col-lg-6">
                  <form method="POST" action="/approvals/{{this._id}}/approve" class="d-flex gap-2">
                    <input class="form-control form-control-sm" name="managerNote" placeholder="{{t 'approvalsManager.approveNotePlaceholder'}}">
                    <button class="btn btn-success btn-sm" type="submit">{{t 'approvalsManager.btnApprove'}}</button>
                  </form>
                </div>
                <div class="col-lg-6">
                  <form method="POST" action="/approvals/{{this._id}}/reject" class="d-flex gap-2">
                    <input class="form-control form-control-sm" name="managerNote" required minlength="3" placeholder="{{t 'approvalsManager.rejectNotePlaceholder'}}">
                    <button class="btn btn-danger btn-sm" type="submit">{{t 'approvalsManager.btnReject'}}</button>
                  </form>
                </div>
              </div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="alert alert-light border mb-0">{{t 'approvalsManager.noPending'}}</div>
      {{/if}}
    </div>
  </div>

  <div class="card card-soft">
    <div class="card-body">
      <h5 class="mb-3">{{t 'approvalsManager.recentTitle'}}</h5>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>{{t 'approvalsManager.thReviewed'}}</th>
              <th>{{t 'approvalsManager.thEmployee'}}</th>
              <th>{{t 'approvalsManager.thType'}}</th>
              <th>{{t 'approvalsManager.thStatus'}}</th>
              <th>{{t 'approvalsManager.thManagerNote'}}</th>
            </tr>
          </thead>
          <tbody>
            {{#if historyRequests.length}}
              {{#each historyRequests}}
                <tr>
                  <td>{{this.reviewedAtText}}</td>
                  <td>{{this.requesterName}}</td>
                  <td>{{this.requestTypeLabel}}</td>
                  <td><span class="badge {{this.statusClass}}">{{this.statusLabel}}</span></td>
                  <td>
                    <div>{{this.managerNote}}</div>
                    <small class="small-muted">{{t 'approvalsManager.lblBy'}} {{this.reviewedByName}}</small>
                  </td>
                </tr>
              {{/each}}
            {{else}}
              <tr>
                <td colspan="5" class="text-center text-muted py-4">{{t 'approvalsManager.noHistory'}}</td>
              </tr>
            {{/if}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
</div>
