<div class="dashboard-employee-view">
<div class="container py-4 employee-dashboard">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
      <h3 class="mb-1">{{t 'dashboardEmployee.title'}}</h3>
      <div class="text-muted">{{t 'dashboardEmployee.hello'}} {{user.name}} ({{user.position}})</div>
    </div>
    <div class="text-muted small">{{t 'dashboardEmployee.updated'}} {{nowText}}</div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-4 col-lg-2">
      <div class="card summary-card p-3">
        <div class="summary-value">{{stats.assigned}}</div>
        <div class="summary-label">{{t 'dashboardEmployee.statAssigned'}}</div>
      </div>
    </div>
    <div class="col-md-4 col-lg-2">
      <div class="card summary-card p-3">
        <div class="summary-value text-primary">{{stats.today}}</div>
        <div class="summary-label">{{t 'dashboardEmployee.statDueToday'}}</div>
      </div>
    </div>
    <div class="col-md-4 col-lg-2">
      <div class="card summary-card p-3">
        <div class="summary-value text-info">{{stats.upcoming}}</div>
        <div class="summary-label">{{t 'dashboardEmployee.statUpcoming'}}</div>
      </div>
    </div>
    <div class="col-md-4 col-lg-2">
      <div class="card summary-card p-3">
        <div class="summary-value text-danger">{{stats.overdue}}</div>
        <div class="summary-label">{{t 'dashboardEmployee.statOverdue'}}</div>
      </div>
    </div>
    <div class="col-md-4 col-lg-2">
      <div class="card summary-card p-3">
        <div class="summary-value text-warning">{{stats.late}}</div>
        <div class="summary-label">{{t 'dashboardEmployee.statLate'}}</div>
      </div>
    </div>
    <div class="col-md-4 col-lg-2">
      <div class="card summary-card p-3">
        <div class="summary-value text-success">{{stats.weeklyHours}}h</div>
        <div class="summary-label">{{t 'dashboardEmployee.statWeekHours'}}</div>
      </div>
    </div>
    <div class="col-md-4 col-lg-3">
      <div class="card summary-card p-3">
        <div class="summary-value text-success format-currency" data-value="{{stats.totalEarned}}">{{stats.totalEarned}}</div>
        <div class="summary-label">{{t 'dashboardEmployee.statTotalEarned'}}</div>
      </div>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-lg-7">
      <div class="card summary-card h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">{{t 'dashboardEmployee.urgentTitle'}}</h5>
            <a href="/my-task" class="btn btn-sm btn-outline-primary">{{t 'dashboardEmployee.btnGoToMyTasks'}}</a>
          </div>
          <div class="table-responsive">
            <table class="table task-table align-middle mb-0">
              <thead>
                <tr>
                  <th>{{t 'dashboardEmployee.thTask'}}</th>
                  <th>{{t 'dashboardEmployee.thDeadline'}}</th>
                  <th>{{t 'dashboardEmployee.thTime'}}</th>
                  <th>{{t 'dashboardEmployee.thStatus'}}</th>
                </tr>
              </thead>
              <tbody>
                {{#if urgentTasks.length}}
                  {{#each urgentTasks}}
                    <tr>
                      <td class="fw-semibold">{{this.taskName}}</td>
                      <td>{{this.deadlineText}}</td>
                      <td>{{this.timeText}}</td>
                      <td><span class="badge {{this.badgeClass}}">{{this.statusText}}</span></td>
                    </tr>
                  {{/each}}
                {{else}}
                  <tr>
                    <td colspan="4" class="text-center text-muted py-4">{{t 'dashboardEmployee.noUrgentTasks'}}</td>
                  </tr>
                {{/if}}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="card summary-card h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">{{t 'dashboardEmployee.recentSalariesTitle'}}</h5>
          </div>
          <div class="table-responsive">
            <table class="table task-table align-middle mb-0">
              <thead>
                <tr>
                  <th>{{t 'dashboardEmployee.thMonth'}}</th>
                  <th>{{t 'dashboardEmployee.thTotalPay'}}</th>
                  <th>{{t 'dashboardEmployee.thStatus'}}</th>
                </tr>
              </thead>
              <tbody>
                {{#if salaryHistory.length}}
                  {{#each salaryHistory}}
                    <tr>
                      <td class="fw-semibold">{{this.period}}</td>
                      <td class="format-currency" data-value="{{this.totalPay}}">{{this.totalPay}}</td>
                      <td><span class="badge {{this.badgeClass}}">{{this.statusText}}</span></td>
                    </tr>
                  {{/each}}
                {{else}}
                  <tr>
                    <td colspan="3" class="text-center text-muted py-4">{{t 'dashboardEmployee.noSalaries'}}</td>
                  </tr>
                {{/if}}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2">
    <a href="/my-task" class="btn btn-primary">{{t 'dashboardEmployee.btnMyTasks'}}</a>
    <a href="/my-task/schedule" class="btn btn-outline-primary">{{t 'dashboardEmployee.btnMySchedule'}}</a>
    <a href="/approvals/my" class="btn btn-outline-warning">{{t 'dashboardEmployee.btnMyRequests'}}</a>
    <a href="/auth" class="btn btn-outline-secondary">{{t 'dashboardEmployee.btnMyProfile'}}</a>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.format-currency').forEach(el => {
      const val = Number(el.getAttribute('data-value')) || 0;
      el.textContent = val.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' });
    });
  });
</script>
</div>
